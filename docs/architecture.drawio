" edge="1" parent="1" source="nginx" target="back"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s3" value="reads/writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="back" target="dvps"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s4" value="WebSocket (the PC opens it)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="back"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s5" value="reverse SSH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="esteira" target="tunel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s6" value="/esteira/" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="nginx" target="tunel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s7" value="WOPI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="back" target="collab"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s8" value="inference" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s9" value="inference" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="esteira" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="esteira" target="dpc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s11" value="daily backup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dpc" target="drive"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s12" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="back" target="ntfy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota" value='&lt;b&gt;Principles&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;• No port open at home: the PC opens the WebSocket and the tunnel.&lt;br&gt;• No central database: files per module;&lt;br&gt;  SQLite only as a rebuildable index.&lt;br&gt;• Claude only through Claude Code (claude -p) on the PC.&lt;br&gt;• Serialized GPU: one heavy slot at a time&lt;br&gt;  (core/locks.py).&lt;br&gt;• Secrets outside git (.env, google/).&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#b3a369;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1270" y="60" width="320" height="204" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="1 · Platform" name="1 · Platform"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1630" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Platform: backend, worker, protocol and main app&lt;/b&gt;" style="text;html=1;fon