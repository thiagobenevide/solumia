" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="core" target="notas"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2" value="chat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="shell" target="v1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s3" value="forwards" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v1" target="ws"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s4" value="chat_request / job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ws" target="wk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s5" value="events, heartbeat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wk" target="ws"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="notas" target="dnotas"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s7" value="loads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wk" target="dmod"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s8" value="Claude tasks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#49505