ue="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cen" target="cl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota" value='&lt;b&gt;Execution rules&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;• One heavy slot at a time (locks.py);&lt;br&gt;  the &amp;#x27;claude&amp;#x27; slot runs in parallel.&lt;br&gt;• Trace and events → app Monitor/graph.&lt;br&gt;• A graphic edited by hand becomes manual: true.&lt;br&gt;• Configuration: config.toml ← profile ←&lt;br&gt;  project config.toml.&lt;br&gt;• 9:16 Shorts: id channel-NNNx.&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#b3a369;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1270" y="60" width="320" height="204" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3 · Empreendimento · N1, dataset and factory" name="3 · Empreendimento · N1, dataset and factory"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1630" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Empreendimento: N1 vocabulary, Craft Apps dataset, piece factory and fine-tuning&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1400" height="40" as="geometry"/></mxCell><mxCell id="r0" value="Who decides" style="swimlane;startSize=28;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;fontStyle=1;horizontal=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="290" height="650" as="geometry"/></mxCell><mxCell id="r1" value="N1 (esteira/n1)" style="swimlane;startSize=28;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;fontStyle=1;horizontal=1;rounded=1;" vertex="1" parent="1">