iece: text, rectangle, ellipse/arc,&lt;br&gt;repeat (grid, assets, slices), animations&lt;br&gt;→ compiler → JSX + core (fit)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="270" height="215" as="geometry"/></mxCell><mxCell id="fc" value='&lt;b&gt;filmcraft.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Edit: ops per track (V1–V4, A1–A3)&lt;br&gt;→ executor → MCP commands&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="340" width="270" height="95" as="geometry"/></mxCell><mxCell id="pc" value='&lt;b&gt;photocraft.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Declarative composition, relational layout&lt;br&gt;[photo] treatment + PhotoDecision&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="460" width="270" height="95" as="geometry"/></mxCell><mxCell id="gate" value='&lt;b&gt;Gate + guide&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;schema, compiles, safe area, local vision&lt;br&gt;N1 EC guide + Lessons (from Claude)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="580" width="270" height="95" as="geometry"/></mxCell><mxCell id="reg" value='&lt;b&gt;records/&amp;lt;app&amp;gt;/&amp;lt;task&amp;gt;/YYYY-MM.jsonl&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;append-only; context, N1 output,&lt;br&gt;gate, origin, versions&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="270" height="215" as="geometry"/></mxCell><mxCell id="art" value='&lt;b&gt;artifacts/ (by sha256)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;large prompts and N1&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="660" y="340" width="270" height="95" as="geometry"/></mxCell><mxCell id="idx" value='&lt;b&gt;index.db (SQLite)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;rebuildable; status per task&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="660" y="460" width="270" height="95" as="geometry"/></mxCell><mxCell id="exp" value='&lt;b&gt;export&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;SFT / DPO / eval (gold), manifest&lt;br&gt;split by group; edit in 45 s chunks&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="660" y="580" width="270" height="95" as="geometry"/></mxCell><mxCell id="tr" value='&lt;b&gt;app training (QLoRA, unsloth)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;base ≤ 12B (gemma-4-12b-it)&lt;br&gt;training venv; worker stopped (VRAM)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="970" y="100" width="270" height="215" as="geometry"/></mxCell><mxCell id="ad" value='&lt;b&gt;adapters/&amp;lt;app&amp;gt;-vN.gguf&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;+ manifest (losses, export hash)&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="970" y="340" width="270" height="95" as="geometry"/></mxCell><mxCell id="ban" value='&lt;b&gt;bench (n1_*)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;base × candidate on gold&lt;br&gt;promotes &amp;lt;app&amp;gt;-current only if it wins&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="970" y="460" width="270" height="95" as="geometry"/></mxCell><mxCell id="pre" value='&lt;b&gt;llama-server --models-preset&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;base + LoRA per app → inference&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="970" y="580" width="270" height="95" as="geometry"/></mxCell><mxCell id="s0" value="ideas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cla" target="loc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1" value="piece.n1.json" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="loc" target="ec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ec" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s3" value="passed → review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gate" target="cla"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s4" value="rules → Lessons" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cla" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s5" value="round + verdict" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gate" target="reg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s6" value="verdicts / edits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pes" target="reg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s7" value="assemble" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fc" target="reg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s8" value="thumbnail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pc" target="reg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#495057;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reg" target="idx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s10" value="" style="edgeStyle=orthogonalEdgeStyle