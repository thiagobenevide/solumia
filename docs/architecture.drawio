" y="60" width="290" height="770" as="geometry"/></mxCell><mxCell id="r2" value="Craft Apps / AI" style="swimlane;startSize=28;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;fontStyle=1;horizontal=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="650" y="60" width="290" height="770" as="geometry"/></mxCell><mxCell id="r3" value="Data ($AGENT_DATA)" style="swimlane;startSize=28;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;fontStyle=1;horizontal=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="960" y="60" width="290" height="770" as="geometry"/></mxCell><mxCell id="rot" value='&lt;b&gt;Script (Obsidian vault)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Notas/Empreendimento/YouTube/&amp;lt;channel&amp;gt;&lt;br&gt;&amp;gt; [!cite] citations with DOI&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="270" height="95" as="geometry"/></mxCell><mxCell id="wav" value='&lt;b&gt;Narration (WAV) or camera&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;dark or presenter mode&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="270" height="95" as="geometry"/></mxCell><mxCell id="perf" value='&lt;b&gt;Channel profile&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;perfis/&amp;lt;channel&amp;gt;.toml + config.toml&lt;br&gt;Studio style&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="270" height="95" as="geometry"/></mxCell><mxCell id="app" value='&lt;b&gt;App (Empreendimento tab)&lt;/b&gt;&lt;br&gt;&lt;font style="font-