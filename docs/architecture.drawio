<mxfile host="app.diagrams.net" type="device"><diagram id="0 · Overview" name="0 · Overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1630" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Overview: who talks to whom (topology and main flow)&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1400" height="40" as="geometry"/></mxCell><mxCell id="r0" value="Clients" style="swimlane;startSize=28;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;fontStyle=1;horizontal=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="290" height="650" as="geometry"/></mxCell><mxCell id="r1" value="VPS (Docker)" style="swimlane;startSize=28;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;fontStyle=1;horizontal=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="290" height="650" as="geometry"/></mxCell><mxCell id="r2" value="PC at home (GPU)" style="swimlane;startSize=28;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;fontStyle=1;horizontal=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="650" y="60" width="290" height="650" as="geometry"/></mxCell><mxCell id="r3" value="Data and services" style="swimlane;startSize=28;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;fontStyle=1;horizontal=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="960" y="60" width="290" height="650" as="geometry"/></mxCell><mxCell id="cli" value='&lt;b&gt;Flutter app&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Android, iOS, tablet, Linux, web&lt;br&gt;one package per module (agent_&amp;lt;m&amp;gt;)&lt;br&gt;login: password + TOTP → JWT&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="270" height=