b&gt;auth&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;scrypt + TOTP + JWT HS256&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="270" height="95" as="geometry"/></mxCell><mxCell id="v1" value='&lt;b&gt;/v1 (OpenAI-compatible)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;chat/models → worker or Claude&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="220" width="270" height="95" as="geometry"/></mxCell><mxCell id="ws" value='&lt;b&gt;/ws + worker_registry&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;WorkerHello, Heartbeat (CPU/RAM/GPU)&lt;br&gt;ChatRequest/Response, WorkerEvent, jobs&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="340" width="270" height="95" as="geometry"/></mxCell><mxCell id="notas" value='&lt;b&gt;/api/notas (vault)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Markdown + YAML frontmatter&lt;br&gt;in-memory index, [[backlinks]]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="460" width="270" height="95" as="geometry"/></mxCell><mxCell id="inet" value='&lt;b&gt;internet/tools&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;FIPE, currencies, B3, Selic/IPCA, web search&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="580" width="270" height="95" as="geometry"/></mxCell><mxCell id=