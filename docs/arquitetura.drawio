;rounded=1;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="290" height="650" as="geometry"/></mxCell><mxCell id="r2" value="Dataset (esteira/dataset)" style="swimlane;startSize=28;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;fontStyle=1;horizontal=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="650" y="60" width="290" height="650" as="geometry"/></mxCell><mxCell id="r3" value="Treino / modelos" style="swimlane;startSize=28;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;fontStyle=1;horizontal=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="960" y="60" width="290" height="650" as="geometry"/></mxCell><mxCell id="cla" value='&lt;b&gt;Claude Code&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;cria ideias em lote (ficha + conceito)&lt;br&gt;revisa a prova: problema, causa, regra&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="270" height="215" as="geometry"/></mxCell><mxCell id="loc" value='&lt;b&gt;LLM local (gemma-4)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;escreve o N1 da peça (porte e ideias)&lt;br&gt;até 4 rodadas com o erro do portão&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="270" height="95" as="geometry"/></mxCell><mxCell id="pes" value='&lt;b&gt;Pessoa (app)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;aprova/reprova peças, montagem e thumb&lt;br&gt;edições manuais no FilmCraft/PhotoCraft&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="270" height="95" as="geometry"/></mxCell><mxCell id="ec" value='&lt;b&gt;effectcraft.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Peca: texto, retângulo, elipse/arco,&lt;br&gt;repetir (grade, ativos, fatias), animações&lt;br&gt;→ compilador → JSX + núcleo (caber)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="270" height="215" as="geometry"/></mxCell><mxCell id="fc" value='&lt;b&gt;filmcraft.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Montagem: ops por trilha (V1–V4, A1–A3)&lt;br&gt;→ executor → comandos MCP&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="340" width="270" height="95" as="geometry"/></mxCell><mxCell id="pc" value='&lt;b&gt;photocraft.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Composição declarativa, layout relacional&lt;br&gt;tratamento [foto] + FotoDecisao&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="460" width="270" height="95" as="geometry"/></mxCell><mxCell id="gate" value='&lt;b&gt;Portão + guia&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;esquema, compila, área segura, visão local&lt;br&gt;GUIA_N1_EC.md + Lições (do Claude)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="580" width="270" height="95" as="geometry"/></mxCell><mxCell id="reg" value='&lt;b&gt;registro/&amp;lt;app&amp;gt;/&amp;lt;tarefa&amp;gt;/AAAA-MM.jsonl&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;só acrescenta; contexto, saída N1,&lt;br&gt;portão, origem, versões&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgro