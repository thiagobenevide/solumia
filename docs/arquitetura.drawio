 id="auth" value='&lt;b&gt;auth&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;scrypt + TOTP + JWT HS256&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="270" height="95" as="geometry"/></mxCell><mxCell id="v1" value='&lt;b&gt;/v1 (OpenAI-compatible)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;chat/models → worker ou Claude&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="220" width="270" height="95" as="geometry"/></mxCell><mxCell id="ws" value='&lt;b&gt;/ws + worker_registry&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;WorkerHello, Heartbeat (CPU/RAM/GPU)&lt;br&gt;ChatRequest/Response, Evento, jobs&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="340" width="270" height="95" as="geometry"/></mxCell><mxCell id="notas" value='&lt;b&gt;/api/notas (cofre)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Markdown + frontmatter YAML&lt;br&gt;índice em memória, [[backlinks]]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="460" width="270" height="95" as="geometry"/></mxCell><mxCell id="inet" value='&lt;b&gt;internet/ferramentas&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;FIPE, moedas, B3, Selic/IPCA, busca web&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="580" width="270" height="95" as="geometry"/>