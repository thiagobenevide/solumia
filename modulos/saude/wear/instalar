#!/usr/bin/env bash
# Builds the watch app (Wear OS), installs it over ADB and writes the address and key on the watch.
#
#   modulos/saude/wear/instalar <watch ip:port> [url]
#
# On the watch: Settings › Developer options › Wi‑Fi debugging (the IP:port shows up there;
# the first time, `adb pair ip:pairing-port` with the code). The key is one of the VPS CLIENT_API_KEYS:
# it comes from $CHAVE or is asked without echo (preferably a `relogio:<key>` one, which only opens the
# watch routes; only the part after `relogio:` goes here). The default url is the .env.prd one (DOMINIO).
# To change the key of an already configured watch: CHAVE_ATUAL=<the old one> (the app only accepts the change
# when the current one is proven, so another app on the watch cannot divert the data).
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../../.." && pwd)"
target="${1:?usage: instalar <watch ip:port> [url]}"
domain="$(grep -E '^DOMINIO=' "$root/.env.prd" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
url="${2:-https://${domain:-agent.thiagobenevide.com}}"
key="${CHAVE:-}"
if [[ -z "$key" ]]; then read -rsp "Client key (CLIENT_API_KEYS): " key; echo; fi

[[ -f "$here/local.properties" ]] || echo "sdk.dir=${ANDROID_HOME:-$HOME/Android/Sdk}" > "$here/local.properties"
echo "▶ Building"
(cd "$here" && ./gradlew -q assembleRelease -Pbuild="${BUILD:-$(( $(date +%s) / 60 ))}")
echo "▶ Installing on $target"
adb connect "$target" >/dev/null
adb -s "$target" install -r "$here/app/build/outputs/apk/release/app-release.apk" >/dev/null
# applicationId stays com.thiagobenevide.agent.relogio; the classes live in the ...agent.watch package.
adb -s "$target" shell am start -n com.thiagobenevide.agent.relogio/com.thiagobenevide.agent.watch.MainActivity \
  --es url "$url" --es chave "$key" ${CHAVE_ATUAL:+--es chave_atual "$CHAVE_ATUAL"} >/dev/null
echo "✔ Done: open the Agent app on the watch ($url)"
