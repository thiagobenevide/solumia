#!/usr/bin/env bash
# Publishes a Solumia release from this PC, without GitHub Actions (same files as
# .github/workflows/release.yml). Usage: infra/scripts/release_local 0.2.0
#   - the tag vX.Y.Z must already be on GitHub;
#   - ~/solumia-release-X.Y.Z/solumia-X.Y.Z-linux-x86_64.AppImage must already exist (optional);
#   - builds the APK signed with ~/solumia-release.jks, signs SHA256SUMS.txt with the release
#     GPG key and creates the GitHub release.
# Passwords are typed at a prompt (keystore) or in the gpg window: never in arguments or history.
set -euo pipefail

VERSION="${1:-}"
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "uso: $0 X.Y.Z" >&2; exit 2; }

REPO="thiagobenevide/solumia"
FPR="401962C4ED4FA05AE568116E68F5115E5B50B880"
KEYSTORE="$HOME/solumia-release.jks"
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
APP="$ROOT/plataforma/app"
PROPS="$APP/android/key.properties"
OUT="$HOME/solumia-release-$VERSION"
FLUTTER="${FLUTTER:-$HOME/development/flutter/bin/flutter}"
IFS=. read -r major minor patch <<< "$VERSION"
BUILD_NUMBER=$((major * 10000 + minor * 100 + patch))  # same rule as the workflow

step() { printf '\n\033[1m== %s\033[0m\n' "$1"; }
fail() { printf '\n\033[31mERRO: %s\033[0m\n' "$1" >&2; exit 1; }
remove_props() { rm -f "$PROPS"; }

[ -f "$KEYSTORE" ] || fail "keystore $KEYSTORE não encontrada (restaure do backup)"
gpg --list-secret-keys "$FPR" >/dev/null 2>&1 || fail "chave GPG $FPR não está neste PC"
gh auth status >/dev/null 2>&1 || fail "gh sem login: rode 'gh auth login'"
gh api "repos/$REPO/git/ref/tags/v$VERSION" >/dev/null 2>&1 || fail "a tag v$VERSION não está no GitHub"
gh release view "v$VERSION" -R "$REPO" >/dev/null 2>&1 && fail "a release v$VERSION já existe"
mkdir -p "$OUT"

step "1/3 APK assinado (versão $VERSION, build $BUILD_NUMBER)"
read -rsp "   Senha da keystore: " KS_PASS; echo
export KS_PASS
keytool -list -keystore "$KEYSTORE" -storepass:env KS_PASS -alias solumia >/dev/null 2>&1 \
    || fail "senha da keystore incorreta"
trap remove_props EXIT
(umask 077; printf 'storeFile=%s\nstorePassword=%s\nkeyAlias=solumia\nkeyPassword=%s\n' \
    "$KEYSTORE" "$KS_PASS" "$KS_PASS" > "$PROPS")
unset KS_PASS
(cd "$APP" && "$FLUTTER" build apk --release --build-name "$VERSION" --build-number "$BUILD_NUMBER" 2>&1 | tail -n 2)
remove_props
cp "$APP/build/app/outputs/flutter-apk/app-release.apk" "$OUT/solumia-$VERSION-android.apk"
# minSdk 26 means APK signature v2+ only: keytool cannot read it, apksigner can.
apksigner=$(ls -d "${ANDROID_HOME:-$HOME/Android/Sdk}"/build-tools/*/apksigner 2>/dev/null | sort -V | tail -n 1)
[ -n "$apksigner" ] || fail "apksigner não encontrado no Android SDK"
signer=$("$apksigner" verify --print-certs "$OUT/solumia-$VERSION-android.apk" | awk -F': ' '/Signer #1 certificate DN/{print $2; exit}')
[ "$signer" = "CN=Solumia, C=BR" ] || fail "APK assinado por '$signer', não pela keystore de release"
echo "   ok: assinado por $signer"

step "2/3 SHA256SUMS assinado"
cd "$OUT"
rm -f SHA256SUMS.txt SHA256SUMS.txt.asc release-signing-key.asc
sha256sum solumia-* > SHA256SUMS.txt
echo "   O gpg vai pedir a senha da chave GPG."
gpg --local-user "$FPR" --armor --detach-sign --output SHA256SUMS.txt.asc SHA256SUMS.txt
gpg --armor --export "$FPR" > release-signing-key.asc
gpg --status-fd 1 --verify SHA256SUMS.txt.asc SHA256SUMS.txt 2>/dev/null | grep -q "VALIDSIG .* $FPR\$" \
    || fail "a assinatura não confere"
sed 's/^/   /' SHA256SUMS.txt

step "3/3 Release v$VERSION no GitHub"
gh release create "v$VERSION" -R "$REPO" --verify-tag --title "Solumia $VERSION" \
    --notes "Publicada a partir do PC (infra/scripts/release_local)." \
    solumia-* SHA256SUMS.txt SHA256SUMS.txt.asc release-signing-key.asc
echo "   ok: https://github.com/$REPO/releases/tag/v$VERSION"
