#!/usr/bin/env bash
# Backup do agent-data e do vault no Google Drive (remote rclone `gdrive`, raiz = pasta backup_agent).
# Por módulo: `<modulo>/atual` é o espelho navegável; `<modulo>/versoes/<data>` guarda o que mudou ou saiu
# naquele dia. O Drive é só leitura: edição feita lá é desfeita no envio seguinte (vai para versoes/).
#   infra/scripts/backup                       # todos os módulos
#   infra/scripts/backup financas notas        # só esses
#   infra/scripts/backup --restaurar <modulo> --destino <pasta> [--data AAAA-MM-DD]
#   infra/scripts/backup --testar [<modulo>]   # restaura numa pasta temporária e confere (teste mensal)
#   infra/scripts/backup --instalar            # timer diário (systemd --user, 03:30)
# Opcional em ~/.config/agent/backup.env: BACKUP_VPS=usuario@host (copia o volume agent-data da VPS).
set -euo pipefail

DADOS="${AGENT_DATA:-$HOME/agent-data}"
VAULT="${VAULT:-$HOME/Documents/github/obsidian}"
REMOTO="${BACKUP_REMOTO:-gdrive:}"
ESTADO="$DADOS/plataforma/backup.json"
RCLONE=$(command -v rclone || echo "$HOME/.local/bin/rclone")
HOJE=$(date +%F)
raiz="$(cd "$(dirname "$0")/../.." && pwd)"
[ -f "$HOME/.config/agent/backup.env" ] && . "$HOME/.config/agent/backup.env"

# Fora de todo módulo: o que se refaz sozinho.
EXCLUIR=(--filter '- cache/**' --filter '- __pycache__/**' --filter '- *.log' --filter '- .venv*/**'
         --filter '- node_modules/**' --filter '- *.tmp' --filter '- .~lock*')
OPCOES=(--fast-list --transfers 8 --checkers 16 --drive-chunk-size 64M --retries 5 --low-level-retries 20 -q)

origem() {  # origem <modulo> → pasta local
  case "$1" in
    vault) echo "$VAULT" ;;
    vps) echo "$DADOS/.vps" ;;
    *) echo "$DADOS/$1" ;;
  esac
}

filtro() {  # filtros extras por módulo → array FILTRO (antes dos gerais)
  case "$1" in
    modelos) FILTRO=(--filter '+ adaptadores/**' --filter '- *') ;;   # GGUF base e vozes se baixam de novo
    vault) FILTRO=(--filter '- .obsidian/workspace*.json' --filter '- .trash/**') ;;
    *) FILTRO=() ;;
  esac
}

modulos() {
  for d in "$DADOS"/*/; do
    m=$(basename "$d")
    case "$m" in plataforma|.vps) continue ;; esac
    echo "$m"
  done
  [ -d "$VAULT" ] && echo vault
  [ -n "${BACKUP_VPS:-}" ] && echo vps
  return 0
}

registrar() {  # registrar <modulo> <inicio> <ok|erro> <msg>
  python3 - "$ESTADO" "$@" <<'EOF'
import json, sys, time
from pathlib import Path
p, m, ini, st, msg = Path(sys.argv[1]), *sys.argv[2:]
d = json.loads(p.read_text()) if p.exists() else {"modulos": {}}
r = d["modulos"].setdefault(m, {})
r.update({"inicio": ini, "fim": time.strftime("%Y-%m-%dT%H:%M:%S"), "estado": st, "erro": msg or None})
if st == "ok":
    r["ultimo_ok"] = r["fim"]
d["ultimo"] = r["fim"]
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(json.dumps(d, ensure_ascii=False, indent=1))
EOF
}

copiar_vps() {  # traz o volume agent-data da VPS para $DADOS/.vps (tar), antes de enviar
  mkdir -p "$DADOS/.vps"
  ssh -o BatchMode=yes "$BACKUP_VPS" \
    'v=$(docker volume ls -q | grep -m1 "agent-data$"); docker run --rm -v "$v":/d:ro alpine tar cz -C /d .' \
    > "$DADOS/.vps/agent-data.tar.gz.parcial"
  mv "$DADOS/.vps/agent-data.tar.gz.parcial" "$DADOS/.vps/agent-data.tar.gz"
}

limpar_versoes() {  # retenção: 7 diários, 4 domingos, 12 dias 01
  local m=$1 hoje_s d s idade
  hoje_s=$(date +%s)
  "$RCLONE" lsf --dirs-only "$REMOTO$m/versoes" 2>/dev/null | tr -d / | while read -r d; do
    s=$(date -d "$d" +%s 2>/dev/null) || continue
    idade=$(( (hoje_s - s) / 86400 ))
    if [ $idade -le 7 ]; then continue; fi
    if [ "$(date -d "$d" +%u)" = 7 ] && [ $idade -le 28 ]; then continue; fi
    if [ "$(date -d "$d" +%d)" = 01 ] && [ $idade -le 366 ]; then continue; fi
    "$RCLONE" purge "$REMOTO$m/versoes/$d" -q
  done
}

enviar() {  # enviar <modulo>
  local m=$1 ini src
  ini=$(date +%Y-%m-%dT%H:%M:%S)
  src=$(origem "$m")
  if [ "$m" = vps ] && ! copiar_vps 2>/tmp/backup-vps.err; then
    registrar "$m" "$ini" erro "$(tail -n 3 /tmp/backup-vps.err)"; return 1
  fi
  [ -d "$src" ] || { registrar "$m" "$ini" erro "pasta ausente: $src"; return 1; }
  filtro "$m"
  if saida=$("$RCLONE" sync "$src" "$REMOTO$m/atual" --backup-dir "$REMOTO$m/versoes/$HOJE" \
              "${EXCLUIR[@]}" "${FILTRO[@]}" "${OPCOES[@]}" 2>&1); then
    limpar_versoes "$m"
    registrar "$m" "$ini" ok ""
    echo "ok     $m"
  else
    registrar "$m" "$ini" erro "$(echo "$saida" | tail -n 3)"
    echo "ERRO   $m: $(echo "$saida" | tail -n 1)"
    return 1
  fi
}

restaurar() {  # restaurar <modulo> <destino> [data]: atual, ou o estado daquele dia (atual + versões posteriores)
  local m=$1 dst=$2 data=${3:-}
  mkdir -p "$dst"
  "$RCLONE" copy "$REMOTO$m/atual" "$dst" "${OPCOES[@]}"
  if [ -n "$data" ]; then  # o que mudou depois de <data> volta à versão guardada, da mais nova para a mais antiga
    "$RCLONE" lsf --dirs-only "$REMOTO$m/versoes" | tr -d / | sort -r | while read -r d; do
      [[ "$d" > "$data" ]] && "$RCLONE" copy "$REMOTO$m/versoes/$d" "$dst" "${OPCOES[@]}"
    done
  fi
  echo "restaurado $m em $dst"
}

testar() {  # restaura um módulo numa pasta temporária e confere contra o Drive
  local m=${1:-financas} tmp ini
  ini=$(date +%Y-%m-%dT%H:%M:%S)
  tmp=$(mktemp -d)
  restaurar "$m" "$tmp" >/dev/null
  if "$RCLONE" check "$tmp" "$REMOTO$m/atual" --one-way -q 2>/dev/null; then
    registrar "teste:$m" "$ini" ok ""; echo "teste de restauração ok: $m"
  else
    registrar "teste:$m" "$ini" erro "arquivos diferentes"; echo "teste de restauração FALHOU: $m"
  fi
  rm -rf "$tmp"
}

instalar() {
  local u="$HOME/.config/systemd/user"
  mkdir -p "$u"
  cat > "$u/agent-backup.service" <<EOF
[Unit]
Description=Backup do agent-data no Google Drive

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
ExecStart=$raiz/infra/scripts/backup
EOF
  cat > "$u/agent-backup.timer" <<EOF
[Unit]
Description=Backup diário do agent-data

[Timer]
OnCalendar=*-*-* 03:30
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
EOF
  cat > "$u/agent-backup-teste.service" <<EOF
[Unit]
Description=Teste mensal de restauração do backup

[Service]
Type=oneshot
ExecStart=$raiz/infra/scripts/backup --testar financas
EOF
  cat > "$u/agent-backup-teste.timer" <<EOF
[Unit]
Description=Teste mensal de restauração do backup

[Timer]
OnCalendar=*-*-01 05:00
Persistent=true

[Install]
WantedBy=timers.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable --now agent-backup.timer agent-backup-teste.timer
  echo "timers instalados: $(systemctl --user list-timers 'agent-backup*' --no-legend | wc -l)"
}

case "${1:-}" in
  --instalar) instalar; exit ;;
  --testar) testar "${2:-}"; exit ;;
  --restaurar)
    m=${2:?uso: backup --restaurar <modulo> --destino <pasta> [--data D]}; shift 2
    dst=""; data=""
    while [ $# -gt 0 ]; do case "$1" in --destino) dst=$2; shift 2 ;; --data) data=$2; shift 2 ;; *) shift ;; esac; done
    restaurar "$m" "${dst:?--destino obrigatório}" "$data"; exit ;;
esac

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/agent-backup.lock"
flock -n 9 || { echo "backup já em andamento"; exit 0; }

if [ $# -gt 0 ]; then alvos=("$@"); else mapfile -t alvos < <(modulos); fi
falhas=0
for m in "${alvos[@]}"; do enviar "$m" || falhas=$((falhas + 1)); done
[ $falhas -eq 0 ] || { echo "$falhas módulo(s) com erro (ver $ESTADO)"; exit 1; }
