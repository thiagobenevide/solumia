#!/usr/bin/env bash
# Connects this PC to the VPS after instalar_vps: fetches the worker key and the tunnel key, writes
# plataforma/worker/.env and installs (systemd --user) three services that restart on their own:
#   agent-esteira  esteira panel (:8765)
#   agent-tunel    reverse SSH tunnel that publishes the esteira at https://<domain>/esteira/
#   agent-worker   worker (local LLM) connected to wss://<domain>/ws/worker
#
#   infra/scripts/conectar_vps user@vps [/path/to/repo/on/vps]
set -euo pipefail

target="${1:?usage: conectar_vps user@vps [/path/to/repo/on/vps]}"
remote_dir="${2:-agent}"
root="$(cd "$(dirname "$0")/../.." && pwd)"
conf="$HOME/.config/agent"
units="$HOME/.config/systemd/user"
mkdir -p "$conf" "$units"
chmod 700 "$conf"

echo "▶ Fetching configuration from $target:$remote_dir"
scp -q "$target:$remote_dir/.env.pc" "$conf/vps.env"
scp -q "$target:$remote_dir/infra/docker/tunel/chave_pc" "$conf/tunel_chave" 2>/dev/null ||
    echo "! chave_pc not found on the VPS: using the TUNEL_CHAVE_PUBLICA one, copy the private key to $conf/tunel_chave"
chmod 600 "$conf"/*
# shellcheck disable=SC1091
set -a; . "$conf/vps.env"; set +a

echo "▶ plataforma/worker/.env"
w="$root/plataforma/worker/.env"
[ -f "$w" ] || cp "$root/plataforma/worker/.env.example" "$w"
for k in WORKER_GATEWAY_URL WORKER_API_KEY; do
    if grep -q "^$k=" "$w"; then sed -i "s|^$k=.*|$k=${!k}|" "$w"; else echo "$k=${!k}" >> "$w"; fi
done
chmod 600 "$w"

echo "▶ systemd --user services"
cat > "$units/agent-esteira.service" <<EOF
[Unit]
Description=Esteira panel (agent)

[Service]
WorkingDirectory=$root/modulos/empreendimento/esteira
ExecStart=$root/modulos/empreendimento/esteira/dark panel --port 8765
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
EOF
cat > "$units/agent-tunel.service" <<EOF
[Unit]
Description=Esteira tunnel to the VPS (agent)
After=network-online.target agent-esteira.service

[Service]
ExecStart=$(command -v ssh) -N -i $conf/tunel_chave -p $TUNEL_PORTA \\
    -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \\
    -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=$conf/known_hosts \\
    -R 0.0.0.0:8765:localhost:8765 tunel@$TUNEL_HOST
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
EOF
cat > "$units/agent-worker.service" <<EOF
[Unit]
Description=Agent worker (local LLM for the VPS)
After=network-online.target

[Service]
ExecStart=$root/infra/scripts/run_worker.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
EOF
systemctl --user daemon-reload
systemctl --user enable --now agent-esteira agent-tunel agent-worker
systemctl --user restart agent-tunel agent-worker
# Without linger the services only start after the graphical login.
loginctl enable-linger "$USER" 2>/dev/null || echo "! run 'sudo loginctl enable-linger $USER' to start at boot"

sleep 5
systemctl --user --no-pager --lines=0 status agent-esteira agent-tunel agent-worker | grep -E '●|Active:'
echo
echo "Logs: journalctl --user -u agent-tunel -u agent-worker -u agent-esteira -f"
