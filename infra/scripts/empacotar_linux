#!/usr/bin/env bash
# Builds the Linux app (release) pointed at the VPS and packs it into plataforma/app/build/agent-linux.tar.gz,
# with instalar.sh (no sudo: ~/.local/opt/agent + menu shortcut). Needs libmpv-dev to compile.
#
#   infra/scripts/empacotar_linux [API_URL]          # default: https://solumialocal.thiagobenevide.com
#   tar -xzf agent-linux.tar.gz && agent/instalar.sh  # on the target PC
set -euo pipefail

url="${1:-https://solumialocal.thiagobenevide.com}"
root="$(cd "$(dirname "$0")/../.." && pwd)"
app="$root/plataforma/app"
flutter="$(command -v flutter || echo "$HOME/development/flutter/bin/flutter")"

pkg-config --exists mpv || { echo "Missing libmpv-dev: sudo apt install -y libmpv-dev" >&2; exit 1; }

cd "$app"
# The cache of a failed configure leaves CMAKE_INSTALL_PREFIX=/usr/local and breaks the install.
grep -qs 'CMAKE_INSTALL_PREFIX:PATH=/usr/local' build/linux/x64/release/CMakeCache.txt && rm -rf build/linux
# BUILD (set by publicar_app) becomes the version number the "Atualizar app" button compares.
"$flutter" build linux --release --dart-define=API_URL="$url" \
    ${BUILD:+--dart-define=BUILD=$BUILD --build-number=$BUILD}

package="$app/build/package"
rm -rf "$package" && mkdir -p "$package/agent"
cp -r build/linux/x64/release/bundle/. "$package/agent/"
cp "$root/plataforma/app_core/assets/logo.png" "$package/agent/agent.png"

cat > "$package/agent/instalar.sh" <<'EOF'
#!/usr/bin/env bash
# Installs Agent for the current user (no sudo): ~/.local/opt/agent + menu shortcut.
set -euo pipefail
source="$(cd "$(dirname "$0")" && pwd)"
target="$HOME/.local/opt/agent"
if ldd "$source"/lib/*.so | grep -q 'not found'; then
    echo "! Missing libraries (video player): sudo apt install -y libmpv2"
fi
rm -rf "$target"
mkdir -p "$target" "$HOME/.local/share/applications" "$HOME/.local/bin"
cp -r "$source/." "$target/"
ln -sf "$target/agent" "$HOME/.local/bin/agent"
# .desktop name and StartupWMClass = APPLICATION_ID (window class), otherwise the panel does not tie the window to the shortcut.
rm -f "$HOME/.local/share/applications/agent.desktop"
cat > "$HOME/.local/share/applications/com.thiagobenevide.agent.desktop" <<DESK
[Desktop Entry]
Type=Application
Name=Agent
Comment=Agent
Exec=$target/agent
Icon=$target/agent.png
Terminal=false
Categories=Office;Utility;
StartupWMClass=com.thiagobenevide.agent
DESK
update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
echo "Agent installed: look for 'Agent' in the menu or run 'agent'."
EOF
chmod +x "$package/agent/instalar.sh"

tar -czf "$app/build/agent-linux.tar.gz" -C "$package" agent
echo "Package: $app/build/agent-linux.tar.gz ($(du -h "$app/build/agent-linux.tar.gz" | cut -f1))"
