#!/usr/bin/env bash
# Endurece o host da VPS: SSH só por chave, firewall (ufw), fail2ban e atualizações de segurança.
# Roda do PC; seguro de repetir.
#
#   infra/scripts/endurecer_vps [usuario@vps]
#
# Para não ficar trancado para fora:
#   1. só começa se o SSH por chave já funciona (com acesso só por senha, para sem mexer em nada);
#   2. antes de qualquer mudança, agenda na VPS um "desfazer" automático para daqui a 5 min;
#   3. libera a(s) porta(s) do SSH no firewall antes de ligá-lo e põe o IP deste PC na lista branca
#      do fail2ban;
#   4. valida o sshd (sshd -t) antes de recarregar, e recarrega (reload): a sessão aberta não cai;
#   5. no fim abre uma conexão SSH nova: só se ela entrar o desfazer é cancelado. Se não entrar, em
#      5 min a VPS volta sozinha ao estado de antes.
set -euo pipefail

raiz="$(cd "$(dirname "$0")/../.." && pwd)"
ler() { grep -E "^$1=" "$raiz/.env.prd" 2>/dev/null | tail -n1 | cut -d= -f2-; }
dominio="$(ler DOMINIO)"; dominio="${dominio:-agent.thiagobenevide.com}"
host="$(ler TUNEL_HOST)"; vps="${1:-root@${host:-$dominio}}"
tunel_porta="$(ler TUNEL_PORTA)"; tunel_porta="${tunel_porta:-2222}"
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=10)

echo "▶ Conferindo o acesso por chave a $vps"
"${SSH[@]}" "$vps" true || { echo "✗ sem acesso por chave: nada foi alterado." >&2; exit 1; }

echo "▶ Aplicando (com desfazer automático em 5 min)"
# shellcheck disable=SC2087
"${SSH[@]}" "$vps" TUNEL_PORTA="$tunel_porta" bash -s <<'REMOTO'
set -euo pipefail
[ "$(id -u)" = 0 ] && SUDO="" || SUDO="sudo -n"
ts="$(date +%Y%m%d-%H%M%S)"
bkp="/root/endurecer-$ts"
$SUDO mkdir -p "$bkp"
meu_ip="${SSH_CONNECTION%% *}"
portas="$($SUDO sshd -T 2>/dev/null | awk '$1=="port"{print $2}' | sort -u | tr '\n' ' ')"
# Sem descobrir a porta real não dá para liberá-la no firewall: para sem mexer em nada.
[ -n "$portas" ] || { echo "✗ não consegui ler a porta do SSH (sshd -T): nada foi alterado." >&2; exit 1; }
echo "porta(s) SSH: $portas | IP deste PC: $meu_ip"

# Chave autorizada para o usuário desta sessão (é por ela que estamos aqui).
chaves="$HOME/.ssh/authorized_keys"
[ -s "$chaves" ] || { echo "✗ $chaves vazio: nada foi alterado." >&2; exit 1; }

# --- 2. desfazer automático ------------------------------------------------------------------
ufw_antes="inativo"
command -v ufw >/dev/null && $SUDO ufw status | grep -q 'Status: active' && ufw_antes="ativo"
$SUDO cp -a /etc/ssh/sshd_config.d "$bkp/" 2>/dev/null || true
$SUDO tee /root/endurecer-desfazer.sh >/dev/null <<EOF
#!/bin/bash
# Gerado por endurecer_vps ($ts): volta SSH e firewall ao estado de antes.
rm -f /etc/ssh/sshd_config.d/00-agent.conf
sshd -t && (systemctl reload ssh 2>/dev/null || systemctl reload sshd)
[ "$ufw_antes" = "inativo" ] && ufw --force disable
systemctl stop fail2ban 2>/dev/null
echo "desfeito em \$(date)" > $bkp/desfeito
EOF
$SUDO chmod 700 /root/endurecer-desfazer.sh
$SUDO systemctl stop agent-desfazer.timer 2>/dev/null || true
$SUDO systemctl reset-failed agent-desfazer.service agent-desfazer.timer 2>/dev/null || true
$SUDO systemd-run --quiet --unit=agent-desfazer --on-active=300 /bin/bash /root/endurecer-desfazer.sh
echo "desfazer agendado: agent-desfazer.timer (5 min)"

# --- pacotes ----------------------------------------------------------------------------------
export DEBIAN_FRONTEND=noninteractive
$SUDO apt-get update -qq >/dev/null
$SUDO apt-get install -y -qq ufw fail2ban unattended-upgrades >/dev/null

# --- 3. firewall: SSH liberado ANTES de ligar -------------------------------------------------
for p in $portas; do $SUDO ufw allow "$p/tcp" >/dev/null; done
$SUDO ufw allow 80/tcp >/dev/null
$SUDO ufw allow 443/tcp >/dev/null
$SUDO ufw allow "${TUNEL_PORTA}/tcp" >/dev/null
$SUDO ufw default deny incoming >/dev/null
$SUDO ufw default allow outgoing >/dev/null
$SUDO ufw --force enable >/dev/null
echo "ufw: ativo (SSH $portas, 80, 443, $TUNEL_PORTA)"

# --- fail2ban (este IP nunca é banido) ---------------------------------------------------------
$SUDO tee /etc/fail2ban/jail.d/agent.local >/dev/null <<EOF
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1 $meu_ip
bantime = 1h
findtime = 10m
maxretry = 5

[sshd]
enabled = true
port = $(echo "$portas" | tr ' ' ',' | sed 's/,$//')
backend = systemd
EOF
$SUDO systemctl enable -q --now fail2ban
$SUDO systemctl restart fail2ban
echo "fail2ban: ativo (lista branca: $meu_ip)"

# --- 4. SSH só por chave (validado antes do reload) -------------------------------------------
# 00- vem antes do 50-cloud-init.conf (no sshd vale o primeiro valor lido).
$SUDO tee /etc/ssh/sshd_config.d/00-agent.conf >/dev/null <<'EOF'
# Gerado por infra/scripts/endurecer_vps.
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password
MaxAuthTries 4
EOF
if ! $SUDO sshd -t; then
    $SUDO rm -f /etc/ssh/sshd_config.d/00-agent.conf
    echo "✗ sshd -t recusou a configuração: SSH mantido como estava." >&2
    exit 1
fi
$SUDO systemctl reload ssh 2>/dev/null || $SUDO systemctl reload sshd
echo "ssh: só chave, root só por chave (reload, sessões abertas seguem)"

# --- atualizações de segurança automáticas ----------------------------------------------------
echo 'APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";' | $SUDO tee /etc/apt/apt.conf.d/20auto-upgrades >/dev/null
echo "unattended-upgrades: ativo (só segurança, sem reiniciar sozinho)"
REMOTO

echo "▶ Testando uma conexão SSH NOVA"
if "${SSH[@]}" "$vps" true; then
    "${SSH[@]}" "$vps" 'systemctl stop agent-desfazer.timer 2>/dev/null || sudo -n systemctl stop agent-desfazer.timer'
    echo "✔ Acesso confirmado: desfazer automático cancelado."
else
    echo "✗ A conexão nova falhou: em até 5 min a VPS desfaz tudo sozinha (SSH e firewall)." >&2
    exit 1
fi
curl -fsS -o /dev/null --max-time 10 "https://$dominio/health" && echo "✔ https://$dominio/health ok" \
    || echo "! https://$dominio/health não respondeu (Cloudflare/DNS?)" >&2
