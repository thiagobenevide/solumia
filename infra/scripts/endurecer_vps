#!/usr/bin/env bash
# Hardens the VPS host: key-only SSH, firewall (ufw), fail2ban and security updates.
# Runs from the PC; safe to repeat.
#
#   infra/scripts/endurecer_vps [user@vps]
#
# To avoid getting locked out:
#   1. it only starts if key-based SSH already works (with password-only access it stops without touching anything);
#   2. before any change, it schedules an automatic "undo" on the VPS for 5 min from now;
#   3. it opens the SSH port(s) in the firewall before enabling it and whitelists this PC's IP
#      in fail2ban;
#   4. it validates sshd (sshd -t) before reloading, and reloads: the open session stays up;
#   5. at the end it opens a NEW SSH connection: only if it gets in is the undo cancelled. If not, within
#      5 min the VPS reverts to its previous state on its own.
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
read_env() { grep -E "^$1=" "$root/.env.prd" 2>/dev/null | tail -n1 | cut -d= -f2-; }
domain="$(read_env DOMINIO)"; domain="${domain:-agent.thiagobenevide.com}"
host="$(read_env TUNEL_HOST)"; vps="${1:-root@${host:-$domain}}"
tunnel_port="$(read_env TUNEL_PORTA)"; tunnel_port="${tunnel_port:-2222}"
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=10)

echo "▶ Checking key access to $vps"
"${SSH[@]}" "$vps" true || { echo "✗ no key access: nothing was changed." >&2; exit 1; }

echo "▶ Applying (with automatic undo in 5 min)"
# shellcheck disable=SC2087
"${SSH[@]}" "$vps" TUNEL_PORTA="$tunnel_port" bash -s <<'REMOTE'
set -euo pipefail
[ "$(id -u)" = 0 ] && SUDO="" || SUDO="sudo -n"
ts="$(date +%Y%m%d-%H%M%S)"
backup_dir="/root/endurecer-$ts"
$SUDO mkdir -p "$backup_dir"
my_ip="${SSH_CONNECTION%% *}"
ports="$($SUDO sshd -T 2>/dev/null | awk '$1=="port"{print $2}' | sort -u | tr '\n' ' ')"
# Without the real port it cannot be opened in the firewall: stop without touching anything.
[ -n "$ports" ] || { echo "✗ could not read the SSH port (sshd -T): nothing was changed." >&2; exit 1; }
echo "SSH port(s): $ports | this PC's IP: $my_ip"

# Authorized key for this session's user (it is how we got in).
keys="$HOME/.ssh/authorized_keys"
[ -s "$keys" ] || { echo "✗ $keys is empty: nothing was changed." >&2; exit 1; }

# --- 2. automatic undo ------------------------------------------------------------------------
ufw_before="inactive"
command -v ufw >/dev/null && $SUDO ufw status | grep -q 'Status: active' && ufw_before="active"
$SUDO cp -a /etc/ssh/sshd_config.d "$backup_dir/" 2>/dev/null || true
$SUDO tee /root/endurecer-desfazer.sh >/dev/null <<EOF
#!/bin/bash
# Generated by endurecer_vps ($ts): restores SSH and firewall to their previous state.
rm -f /etc/ssh/sshd_config.d/00-agent.conf
sshd -t && (systemctl reload ssh 2>/dev/null || systemctl reload sshd)
[ "$ufw_before" = "inactive" ] && ufw --force disable
systemctl stop fail2ban 2>/dev/null
echo "undone at \$(date)" > $backup_dir/desfeito
EOF
$SUDO chmod 700 /root/endurecer-desfazer.sh
$SUDO systemctl stop agent-desfazer.timer 2>/dev/null || true
$SUDO systemctl reset-failed agent-desfazer.service agent-desfazer.timer 2>/dev/null || true
$SUDO systemd-run --quiet --unit=agent-desfazer --on-active=300 /bin/bash /root/endurecer-desfazer.sh
echo "undo scheduled: agent-desfazer.timer (5 min)"

# --- packages ---------------------------------------------------------------------------------
export DEBIAN_FRONTEND=noninteractive
$SUDO apt-get update -qq >/dev/null
$SUDO apt-get install -y -qq ufw fail2ban unattended-upgrades >/dev/null

# --- 3. firewall: SSH opened BEFORE enabling -----------------------------------------------
for p in $ports; do $SUDO ufw allow "$p/tcp" >/dev/null; done
$SUDO ufw allow 80/tcp >/dev/null
$SUDO ufw allow 443/tcp >/dev/null
$SUDO ufw allow "${TUNEL_PORTA}/tcp" >/dev/null
$SUDO ufw default deny incoming >/dev/null
$SUDO ufw default allow outgoing >/dev/null
$SUDO ufw --force enable >/dev/null
echo "ufw: active (SSH $ports, 80, 443, $TUNEL_PORTA)"

# --- fail2ban (this IP is never banned) --------------------------------------------------------
$SUDO tee /etc/fail2ban/jail.d/agent.local >/dev/null <<EOF
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1 $my_ip
bantime = 1h
findtime = 10m
maxretry = 5

[sshd]
enabled = true
port = $(echo "$ports" | tr ' ' ',' | sed 's/,$//')
backend = systemd
EOF
$SUDO systemctl enable -q --now fail2ban
$SUDO systemctl restart fail2ban
echo "fail2ban: active (whitelist: $my_ip)"

# --- 4. key-only SSH (validated before reload) -----------------------------------------------
# 00- comes before 50-cloud-init.conf (sshd keeps the first value it reads).
$SUDO tee /etc/ssh/sshd_config.d/00-agent.conf >/dev/null <<'EOF'
# Generated by infra/scripts/endurecer_vps.
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password
MaxAuthTries 4
EOF
if ! $SUDO sshd -t; then
    $SUDO rm -f /etc/ssh/sshd_config.d/00-agent.conf
    echo "✗ sshd -t rejected the configuration: SSH kept as it was." >&2
    exit 1
fi
$SUDO systemctl reload ssh 2>/dev/null || $SUDO systemctl reload sshd
echo "ssh: key only, root key only (reload, open sessions stay up)"

# --- automatic security updates -------------------------------------------------------------
echo 'APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";' | $SUDO tee /etc/apt/apt.conf.d/20auto-upgrades >/dev/null
echo "unattended-upgrades: active (security only, no automatic reboot)"
REMOTE

echo "▶ Testing a NEW SSH connection"
if "${SSH[@]}" "$vps" true; then
    "${SSH[@]}" "$vps" 'systemctl stop agent-desfazer.timer 2>/dev/null || sudo -n systemctl stop agent-desfazer.timer'
    echo "✔ Access confirmed: automatic undo cancelled."
else
    echo "✗ The new connection failed: within 5 min the VPS undoes everything on its own (SSH and firewall)." >&2
    exit 1
fi
curl -fsS -o /dev/null --max-time 10 "https://$domain/health" && echo "✔ https://$domain/health ok" \
    || echo "! https://$domain/health did not respond (Cloudflare/DNS?)" >&2
