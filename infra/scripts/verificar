#!/usr/bin/env bash
# Validates only what changed (or the given paths) with minimal output: one line per check
# and, on failure, only the error lines. Made so Claude spends few tokens.
#   infra/scripts/verificar                 # files changed/new since HEAD
#   infra/scripts/verificar <path>...       # forces the scope (files or folders)
#   VERIFICAR_LINHAS=60 infra/scripts/verificar
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

MAX_LINES=${VERIFICAR_LINHAS:-30}
FLUTTER=$(command -v flutter || echo "$HOME/development/flutter/bin/flutter")
RUFF=.venv/bin/ruff
PY=.venv/bin/python
PY_PIPELINE=modulos/empreendimento/esteira/.venv/bin/python
failures=0

if [ $# -gt 0 ]; then
  mapfile -t files < <(git ls-files --cached --others --exclude-standard -- "$@")
else
  mapfile -t files < <({ git diff --name-only HEAD; git ls-files --others --exclude-standard; } | sort -u)
fi
mapfile -t files < <(for f in "${files[@]}"; do [ -f "$f" ] && echo "$f"; done)
[ ${#files[@]} -eq 0 ] && { echo "nothing changed"; exit 0; }

run() {  # run <label> <command...>: prints "ok" or the last lines of the output
  local label=$1; shift
  local output
  if output=$("$@" 2>&1); then
    echo "ok     $label"
  else
    echo "FAILED $label"
    echo "$output" | grep -vE '^\s*$' | tail -n "$MAX_LINES" | sed 's/^/  /'
    failures=$((failures + 1))
  fi
}

py=(); py_plat=(); py_pipeline=(); py_capture=(); declare -A dart_packages=()
for a in "${files[@]}"; do
  case "$a" in
    *.py) py+=("$a")
          case "$a" in
            plataforma/*|modulos/*/backend/*) py_plat+=("$a") ;;
            modulos/empreendimento/esteira/*) py_pipeline+=("$a") ;;
            modulos/empreendimento/capture/*) py_capture+=("$a") ;;
          esac ;;
    *.dart|*/pubspec.yaml)
          for p in plataforma/app_core plataforma/app_notas plataforma/app modulos/*/app; do
            [[ "$a" == "$p/"* ]] && { dart_packages[$p]=1; break; }
          done ;;
  esac
done

[ ${#py[@]} -gt 0 ] && run "ruff (${#py[@]} files)" "$RUFF" check -q --output-format concise "${py[@]}"
[ ${#py_plat[@]} -gt 0 ] && run "pytest plataforma" "$PY" -m pytest -q -x --no-header -p no:cacheprovider
# Studio engine: runs on the system Python (GStreamer from apt); the model tests do not need it
[ ${#py_capture[@]} -gt 0 ] && run "pytest capture" \
  bash -c "cd modulos/empreendimento/capture && PYTHONPATH=. '$PWD/$PY' -m pytest -q -x --no-header -p no:cacheprovider tests"
[ ${#py_pipeline[@]} -gt 0 ] && run "pytest esteira" \
  bash -c "cd modulos/empreendimento/esteira && '$PWD/$PY_PIPELINE' -m pytest -q -x --no-header -p no:cacheprovider tests"

for p in "${!dart_packages[@]}"; do
  # "level • message. Try … • file:l:c • code" becomes "file:l:c code: message" (without the hint).
  run "flutter analyze $p" bash -c "'$FLUTTER' analyze --no-pub '$p' 2>&1 \
    | awk -F ' • ' 'NF>=4 { sub(/\\. .*/, \"\", \$2); print \$3, \$4\": \"\$2; next } /issues? found/'; \
    exit \${PIPESTATUS[0]}"
done

[ $failures -eq 0 ] && exit 0 || exit 1
