#!/usr/bin/env bash
# Valida só o que mudou (ou os caminhos dados) com saída mínima: uma linha por checagem
# e, quando falha, só as linhas de erro. Feito para o Claude gastar poucos tokens.
#   infra/scripts/verificar                 # arquivos alterados/novos desde o HEAD
#   infra/scripts/verificar <caminho>...    # força o escopo (arquivos ou pastas)
#   VERIFICAR_LINHAS=60 infra/scripts/verificar
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

LINHAS=${VERIFICAR_LINHAS:-30}
FLUTTER=$(command -v flutter || echo "$HOME/development/flutter/bin/flutter")
RUFF=.venv/bin/ruff
PY=.venv/bin/python
PY_ESTEIRA=modulos/empreendimento/esteira/.venv/bin/python
falhas=0

if [ $# -gt 0 ]; then
  mapfile -t arqs < <(git ls-files --cached --others --exclude-standard -- "$@")
else
  mapfile -t arqs < <({ git diff --name-only HEAD; git ls-files --others --exclude-standard; } | sort -u)
fi
mapfile -t arqs < <(for a in "${arqs[@]}"; do [ -f "$a" ] && echo "$a"; done)
[ ${#arqs[@]} -eq 0 ] && { echo "nada alterado"; exit 0; }

rodar() {  # rodar <rótulo> <comando...>: imprime "ok" ou as últimas linhas da saída
  local rotulo=$1; shift
  local saida
  if saida=$("$@" 2>&1); then
    echo "ok     $rotulo"
  else
    echo "FALHOU $rotulo"
    echo "$saida" | grep -vE '^\s*$' | tail -n "$LINHAS" | sed 's/^/  /'
    falhas=$((falhas + 1))
  fi
}

py=(); py_plat=(); py_esteira=(); py_capture=(); declare -A dart_pacotes=()
for a in "${arqs[@]}"; do
  case "$a" in
    *.py) py+=("$a")
          case "$a" in
            plataforma/*|modulos/*/backend/*) py_plat+=("$a") ;;
            modulos/empreendimento/esteira/*) py_esteira+=("$a") ;;
            modulos/empreendimento/capture/*) py_capture+=("$a") ;;
          esac ;;
    *.dart|*/pubspec.yaml)
          for p in plataforma/app_core plataforma/app_notas plataforma/app modulos/*/app; do
            [[ "$a" == "$p/"* ]] && { dart_pacotes[$p]=1; break; }
          done ;;
  esac
done

[ ${#py[@]} -gt 0 ] && rodar "ruff (${#py[@]} arquivos)" "$RUFF" check -q --output-format concise "${py[@]}"
[ ${#py_plat[@]} -gt 0 ] && rodar "pytest plataforma" "$PY" -m pytest -q -x --no-header -p no:cacheprovider
# motor do Estúdio: roda no Python do sistema (GStreamer do apt); os testes do modelo não precisam dele
[ ${#py_capture[@]} -gt 0 ] && rodar "pytest capture" \
  bash -c "cd modulos/empreendimento/capture && PYTHONPATH=. '$PWD/$PY' -m pytest -q -x --no-header -p no:cacheprovider tests"
[ ${#py_esteira[@]} -gt 0 ] && rodar "pytest esteira" \
  bash -c "cd modulos/empreendimento/esteira && '$PWD/$PY_ESTEIRA' -m pytest -q -x --no-header -p no:cacheprovider tests"

for p in "${!dart_pacotes[@]}"; do
  # "nível • mensagem. Try … • arq:l:c • código" vira "arq:l:c código: mensagem" (sem a sugestão).
  rodar "flutter analyze $p" bash -c "'$FLUTTER' analyze --no-pub '$p' 2>&1 \
    | awk -F ' • ' 'NF>=4 { sub(/\\. .*/, \"\", \$2); print \$3, \$4\": \"\$2; next } /issues? found/'; \
    exit \${PIPESTATUS[0]}"
done

[ $falhas -eq 0 ] && exit 0 || exit 1
