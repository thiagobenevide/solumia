#!/usr/bin/env bash
# Installs (or updates) the VPS in one command: Docker, secrets, gateway, esteira tunnel, nginx and TLS.
#
#   git clone <repo> agent && cd agent
#   cp .env.prd.example .env.prd   # fill in DOMINIO, EMAIL and ADMIN_SENHA
#   sudo infra/scripts/instalar_vps
#
# Running it again is safe: it reuses secrets, keys and certificate; it only rebuilds and restarts.
# At the end it writes .env.pc and infra/docker/tunel/chave_pc, which the PC fetches with infra/scripts/conectar_vps.
set -euo pipefail

[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"

root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$root"
prd="$root/.env.prd"
env_backend="$root/plataforma/backend/.env"
tunnel_dir="$root/infra/docker/tunel"
owner="${SUDO_USER:-root}"

dc() { docker compose -f "$root/infra/docker/docker-compose.yml" "$@"; }
step() { printf '\n\033[1m▶ %s\033[0m\n' "$*"; }
warn() { printf '\033[33m! %s\033[0m\n' "$*"; }
fail() { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }

# read_key FILE KEY: last value of the key, without surrounding quotes.
read_key() {
    [ -f "$1" ] || return 0
    sed -n "s/^$2=//p" "$1" | tail -n 1 | sed -e "s/^'\(.*\)'$/\1/" -e 's/^"\(.*\)"$/\1/'
}
# setting KEY [DEFAULT]: .env.prd > .env from a previous install (secrets) > default.
setting() {
    local v
    v="$(read_key "$prd" "$1")"
    [ -n "$v" ] || v="$(read_key "$env_backend" "$1")"
    printf '%s' "${v:-${2:-}}"
}
random_token() { head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 43; }
in_gateway() { dc run --rm --no-deps -T "$@"; }

[ -f "$prd" ] || fail ".env.prd not found: cp .env.prd.example .env.prd and fill it in."
domain="$(read_key "$prd" DOMINIO)"
email="$(read_key "$prd" EMAIL)"
[ -n "$domain" ] && [ "$domain" != "agent.seu-dominio.com" ] || fail "Set DOMINIO in .env.prd."
[ -n "$email" ] || fail "Set EMAIL in .env.prd (Let's Encrypt notices)."
tunnel_host="$(read_key "$prd" TUNEL_HOST)"; tunnel_host="${tunnel_host:-$domain}"
tunnel_port="$(read_key "$prd" TUNEL_PORTA)"; tunnel_port="${tunnel_port:-2222}"
export TUNEL_PORTA="$tunnel_port"

# ---------------------------------------------------------------------------------------------
step "System packages"
if command -v apt-get >/dev/null; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y -qq curl ca-certificates openssh-client qrencode >/dev/null
fi
if ! command -v docker >/dev/null; then
    curl -fsSL https://get.docker.com | sh
fi
systemctl enable --now docker >/dev/null 2>&1 || true
docker compose version >/dev/null || fail "docker compose (plugin v2) not found."

mode="$(read_key "$prd" NGINX_MODO)"
if [ -z "$mode" ]; then
    systemctl is-active --quiet nginx 2>/dev/null && mode=host || mode=docker
fi
echo "nginx: $mode"

# ---------------------------------------------------------------------------------------------
step "Images"
[ -f "$tunnel_dir/authorized_keys" ] || : > "$tunnel_dir/authorized_keys"
dc build -q gateway tunel
# Pinned Collabora and certbot versions: the first time it records the digest of the images already pulled (the
# running ones). To update on purpose: delete infra/docker/imagens.env and run again.
images_env="$root/infra/docker/imagens.env"
if [ ! -f "$images_env" ]; then
    for pair in COLLABORA_IMAGEM=collabora/code:latest CERTBOT_IMAGEM=certbot/certbot:latest; do
        img="${pair#*=}"
        docker image inspect "$img" >/dev/null 2>&1 || docker pull -q "$img" >/dev/null
        echo "${pair%%=*}=$(docker image inspect -f '{{index .RepoDigests 0}}' "$img")"
    done > "$images_env.new"
    mv "$images_env.new" "$images_env"
fi
set -a; . "$images_env"; set +a
echo "images: $(cut -d@ -f2 "$images_env" | cut -c1-19 | tr '\n' ' ')"

# ---------------------------------------------------------------------------------------------
step "Secrets and plataforma/backend/.env"
password="$(read_key "$prd" ADMIN_SENHA)"
password_hash="$(read_key "$env_backend" GATEWAY_ADMIN_SENHA_HASH)"
if [ -z "$password" ] && [ -z "$password_hash" ]; then
    [ -t 0 ] || fail "Set ADMIN_SENHA in .env.prd (first install)."
    read -rsp "App password (min. 12 characters): " password; echo
fi
if [ -n "$password" ]; then
    [ "${#password}" -ge 12 ] || fail "ADMIN_SENHA needs at least 12 characters."
    password_hash="$(PASSWORD="$password" in_gateway -e PASSWORD gateway python -c \
        'import os; from backend.auth.security import generate_hash_password as g; print(g(os.environ["PASSWORD"]))')"
fi
totp="$(setting GATEWAY_ADMIN_TOTP_SEGREDO)"
totp_new=0
if [ -z "$totp" ]; then
    totp="$(in_gateway gateway python -c 'from backend.auth.security import generate_secret_totp as g; print(g())')"
    totp_new=1
fi
username="$(setting GATEWAY_ADMIN_USUARIO admin)"
jwt="$(setting GATEWAY_JWT_SECRET_KEY "$(random_token)$(random_token)")"
client_key="$(setting GATEWAY_CLIENT_API_KEYS "sk_live_$(random_token)")"
worker_key="$(setting GATEWAY_WORKER_API_KEYS "worker_$(random_token)")"

fixed_keys=(GATEWAY_ENVIRONMENT GATEWAY_DEBUG GATEWAY_LOG_FORMAT GATEWAY_LOG_LEVEL GATEWAY_CORS_ORIGINS
    GATEWAY_CLIENT_API_KEYS GATEWAY_WORKER_API_KEYS GATEWAY_ADMIN_USUARIO GATEWAY_ADMIN_SENHA_HASH
    GATEWAY_ADMIN_TOTP_SEGREDO GATEWAY_JWT_SECRET_KEY GATEWAY_YOUTUBE_VAULT)
umask 077
{
    echo "# Generated by infra/scripts/instalar_vps — edit .env.prd and run again."
    echo "GATEWAY_ENVIRONMENT=production"
    echo "GATEWAY_DEBUG=false"
    echo "GATEWAY_LOG_FORMAT=$(setting GATEWAY_LOG_FORMAT json)"
    echo "GATEWAY_LOG_LEVEL=$(setting GATEWAY_LOG_LEVEL info)"
    echo "GATEWAY_CORS_ORIGINS=$(setting GATEWAY_CORS_ORIGINS "https://$domain")"
    echo "GATEWAY_CLIENT_API_KEYS=$client_key"
    echo "GATEWAY_WORKER_API_KEYS=$worker_key"
    echo "GATEWAY_ADMIN_USUARIO=$username"
    echo "GATEWAY_ADMIN_SENHA_HASH='$password_hash'"
    echo "GATEWAY_ADMIN_TOTP_SEGREDO=$totp"
    echo "GATEWAY_JWT_SECRET_KEY=$jwt"
    echo "GATEWAY_YOUTUBE_VAULT=$(setting GATEWAY_YOUTUBE_VAULT '~/agent-data/obsidian')"
    # The other GATEWAY_* in .env.prd pass through as they are (see plataforma/backend/.env.example).
    grep -E '^GATEWAY_[A-Z0-9_]+=' "$prd" | while IFS= read -r line; do
        [[ " ${fixed_keys[*]} " == *" ${line%%=*} "* ]] || echo "$line"
    done || true
} > "$env_backend.new"
umask 022
mv "$env_backend.new" "$env_backend"

# ---------------------------------------------------------------------------------------------
step "Esteira tunnel key"
public_key="$(read_key "$prd" TUNEL_CHAVE_PUBLICA)"
if [ -z "$public_key" ]; then
    [ -f "$tunnel_dir/chave_pc" ] || ssh-keygen -q -t ed25519 -N '' -C agent-tunel -f "$tunnel_dir/chave_pc"
    chown "$owner" "$tunnel_dir/chave_pc" "$tunnel_dir/chave_pc.pub"
    public_key="$(cat "$tunnel_dir/chave_pc.pub")"
fi
# restrict: the key only opens the esteira reverse forwarding, nothing else.
echo "restrict,port-forwarding,permitlisten=\"0.0.0.0:8765\" $public_key" > "$tunnel_dir/authorized_keys"
chmod 644 "$tunnel_dir/authorized_keys"

# ---------------------------------------------------------------------------------------------
step "Gateway and tunnel"
dc up -d --force-recreate gateway tunel
for _ in $(seq 30); do
    curl -fsS http://127.0.0.1:48080/health >/dev/null 2>&1 && break
    sleep 2
done
curl -fsS http://127.0.0.1:48080/health >/dev/null || { dc logs --tail 40 gateway; fail "Gateway did not respond."; }
echo "gateway ok"

# ---------------------------------------------------------------------------------------------
step "nginx and TLS certificate ($domain)"
ip_vps="$(curl -fsS4 --max-time 5 https://api.ipify.org || true)"
ip_dns="$(getent ahostsv4 "$domain" | awk 'NR==1{print $1}' || true)"
[ -n "$ip_dns" ] || warn "$domain does not resolve in DNS yet: the certificate will fail."
[ -z "$ip_vps" ] || [ -z "$ip_dns" ] || [ "$ip_vps" = "$ip_dns" ] ||
    warn "$domain points to $ip_dns, the VPS is $ip_vps (ok if Cloudflare Proxied)."

if [ "$mode" = docker ]; then
    conf="$root/infra/docker/nginx/nginx.conf"
    if ! dc run --rm --no-deps --entrypoint test certbot -f "/etc/letsencrypt/live/$domain/fullchain.pem"; then
        # Before the certificate: only port 80 with the Let's Encrypt challenge.
        cat > "$conf" <<EOF
server {
    listen 80;
    server_name $domain;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 503; }
}
EOF
        dc up -d nginx
        dc restart nginx
        dc run --rm --no-deps --entrypoint certbot certbot certonly --webroot -w /var/www/certbot \
            -d "$domain" --email "$email" --agree-tos --non-interactive --no-eff-email
    fi
    cp "$conf" "$conf.prev" 2>/dev/null || : > "$conf.prev"
    sed "s/seu-dominio\.exemplo\.com/$domain/g" "$root/infra/docker/nginx/nginx.conf.example" > "$conf"
    # Validates in a separate container before replacing what is live; invalid = restore the previous one.
    if ! dc run --rm --no-deps --entrypoint nginx nginx -t -q; then
        mv "$conf.prev" "$conf"
        fail "new nginx.conf is invalid: kept the previous one (the site stays up)."
    fi
    rm -f "$conf.prev"
    dc up -d nginx certbot
    dc restart nginx
else
    dpkg -s python3-certbot-nginx >/dev/null 2>&1 || apt-get install -y -qq certbot python3-certbot-nginx >/dev/null
    site="/etc/nginx/sites-available/agent-$domain.conf"
    # After certbot the file has the TLS lines: it is only written the first time.
    [ -f "$site" ] || sed "s/seu-dominio\.exemplo\.com/$domain/g" \
        "$root/infra/docker/nginx/host-nginx-site.conf.example" > "$site"
    ln -sf "$site" "/etc/nginx/sites-enabled/agent-$domain.conf"
    # Real IP (Cloudflare) and login rate limit; the old site (written only the first time) gets the same
    # fixes: X-Forwarded-For without what the client sent, and the login/admin locations.
    cp "$site" "$site.prev"
    cp "$root/infra/docker/nginx/seguranca-http.conf" /etc/nginx/conf.d/agent-seguranca.conf
    # Cloudflare real IP set by hand on old installs: agent-seguranca.conf replaces it
    # (two real_ip_header directives break nginx -t).
    old_conf=/etc/nginx/conf.d/cloudflare-realip.conf
    [ -f "$old_conf" ] && grep -q real_ip_header "$old_conf" && mv "$old_conf" "$old_conf.desativado"
    sed -i 's/\$proxy_add_x_forwarded_for/$remote_addr/' "$site"
    if ! grep -q 'agent_login' "$site"; then
        sed -n '/# Login rate-limited by real IP/,/cool\/adminws/p' \
            "$root/infra/docker/nginx/host-nginx-site.conf.example" > "$site.snippet"
        sed -i "/client_max_body_size/r $site.snippet" "$site"
        rm -f "$site.snippet"
    fi
    if ! nginx -t -q; then
        mv "$site.prev" "$site"; rm -f /etc/nginx/conf.d/agent-seguranca.conf
        [ -f "$old_conf.desativado" ] && mv "$old_conf.desativado" "$old_conf"
        fail "New nginx configuration is invalid: kept the previous one (the site stays up)."
    fi
    rm -f "$site.prev"
    systemctl reload nginx
    certbot --nginx -d "$domain" -m "$email" --agree-tos --non-interactive --no-eff-email \
        --redirect --keep-until-expiring
fi

# ---------------------------------------------------------------------------------------------
step "Firewall"
if command -v ufw >/dev/null && ufw status | grep -q 'Status: active'; then
    ufw allow 80/tcp >/dev/null; ufw allow 443/tcp >/dev/null; ufw allow "$tunnel_port/tcp" >/dev/null
    echo "ufw: 80, 443 and $tunnel_port opened"
else
    echo "ufw inactive; open 80, 443 and $tunnel_port/tcp in the provider firewall, if any"
fi

# ---------------------------------------------------------------------------------------------
step "Checking https://$domain"
ok=0
for _ in $(seq 10); do
    curl -fsS "https://$domain/health" >/dev/null 2>&1 && { ok=1; break; }
    sleep 3
done
[ "$ok" = 1 ] && echo "https ok" || warn "https://$domain/health has not responded yet (DNS/Cloudflare?)."

cat > "$root/.env.pc" <<EOF
# Read by infra/scripts/conectar_vps on the PC. Contains the worker key: do not commit.
WORKER_GATEWAY_URL=wss://$domain/ws/worker
WORKER_API_KEY=${worker_key%%,*}
TUNEL_HOST=$tunnel_host
TUNEL_PORTA=$tunnel_port
EOF
chmod 600 "$root/.env.pc"
chown "$owner" "$root/.env.pc"

# ---------------------------------------------------------------------------------------------
step "Done"
cat <<EOF
API:            https://$domain   (login: $username + password + Google Authenticator)
Esteira:        https://$domain/esteira/   (via the PC tunnel, same login)
/v1 key:        $client_key
Data:           docker volume agent-data (notes, finances, files...)

On the PC, at the repo root:
  infra/scripts/conectar_vps $owner@$tunnel_host $root

Apps (phone/tablet):
  flutter build apk --release --dart-define=API_URL=https://$domain
EOF
if [ "$totp_new" = 1 ]; then
    uri="$(in_gateway gateway python -c \
        "from backend.auth.security import uri_totp; print(uri_totp('$totp', '$username'))")"
    echo
    echo "Google Authenticator: scan the QR or use the key $totp"
    command -v qrencode >/dev/null && qrencode -t ansiutf8 "$uri"
fi
[ -z "$(read_key "$prd" ADMIN_SENHA)" ] || warn "Delete ADMIN_SENHA from .env.prd: the hash is already in .env."
