#!/usr/bin/env bash
# Updates the VPS to GitHub's master: git pull in the repository there, runs instalar_vps
# (safe to repeat: it only rebuilds and restarts) and restarts the PC's esteira and worker. The VPS
# comes from .env.prd (TUNEL_HOST, DOMINIO).
#
#   infra/scripts/atualizar_vps [user@vps]
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
read_env() { { grep -E "^$1=" "$root/.env.prd" 2>/dev/null || true; } | tail -n1 | cut -d= -f2-; }
domain="$(read_env DOMINIO)"; domain="${domain:-solumialocal.thiagobenevide.com}"
host="$(read_env TUNEL_HOST)"; vps="${1:-root@${host:-$domain}}"

echo "▶ Updating $vps"
# The repository folder there comes from the docker compose label (…/infra/docker); otherwise, the usual places.
# shellcheck disable=SC2016
ssh -o BatchMode=yes "$vps" bash -s <<'EOF'
set -euo pipefail
dir="$(docker ps -q | head -n1 | xargs -r docker inspect -f '{{ index .Config.Labels "com.docker.compose.project.working_dir" }}' 2>/dev/null || true)"
repo="${dir%/infra/docker}"
if [ ! -x "$repo/infra/scripts/instalar_vps" ]; then
    for d in ~/agent /opt/agent /root/agent /home/*/agent; do
        [ -x "$d/infra/scripts/instalar_vps" ] && repo="$d" && break
    done
fi
[ -x "$repo/infra/scripts/instalar_vps" ] || { echo "✗ repository not found on the VPS" >&2; exit 1; }
cd "$repo"
echo "▶ $repo: $(git log --oneline -1)"
git fetch -q origin
# History rewritten on GitHub (e.g. a removed secret): the fast-forward fails; reset --keep moves
# to the new master and refuses if there is a tracked local change (nothing is lost).
git merge --ff-only -q origin/master 2>/dev/null || git reset -q --keep origin/master
echo "▶ now: $(git log --oneline -1)"
infra/scripts/instalar_vps 2>&1 | tail -n 15
EOF

echo "▶ Checking the new route"
curl -s -o /dev/null -w '/api/codigo/arvore → HTTP %{http_code} (401 = exists, needs login; 404 = still old)\n' \
    "https://$domain/api/codigo/arvore"

# The esteira and the worker run on the PC (user systemd services): without a restart they keep
# the old code even with the VPS up to date. Code requests are children of the worker, so if this
# script runs inside it, the worker restart is scheduled 60 s later (outside the service) so it does
# not kill the session that asked for the update.
echo "▶ Restarting the PC services"
if systemctl --user cat agent-esteira >/dev/null 2>&1; then
    systemctl --user restart agent-esteira && echo "agent-esteira restarted"
fi
if systemctl --user cat agent-worker >/dev/null 2>&1; then
    if grep -q 'agent-worker\.service' /proc/self/cgroup; then
        systemd-run --user --quiet --on-active=60 systemctl --user restart agent-worker \
            && echo "agent-worker restarts in 60 s (this request runs inside it)"
    else
        systemctl --user restart agent-worker && echo "agent-worker restarted"
    fi
fi
