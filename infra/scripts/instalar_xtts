#!/usr/bin/env bash
# Creates the XTTS-v2 venv (worker speech) and downloads the model (~1.8 GB the first time).
set -euo pipefail
dir="$(cd "$(dirname "$0")/../../plataforma/worker/xtts" && pwd)"
uv="$(command -v uv || echo "$HOME/.local/bin/uv")"
"$uv" venv -q -p 3.12 "$dir/.venv"
"$uv" pip install -q -p "$dir/.venv/bin/python" --index-strategy unsafe-best-match -r "$dir/requirements.txt"
sample="$(mktemp --suffix=.wav)"
echo "{\"texto\": \"Pronto.\", \"saida\": \"$sample\"}" \
    | "$dir/.venv/bin/python" "$dir/servidor.py" "Ana Florence" pt | tail -n 1
rm -f "$sample"
