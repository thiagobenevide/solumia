# Variant for a SHARED VPS — when the VPS already runs other
# sites/services on an nginx installed directly on the host (outside Docker), instead
# of this repo's dockerized nginx (infra/docker/nginx/nginx.conf).
#
# Main difference from the "default" nginx.conf.example: here proxy_pass
# points to 127.0.0.1:48080 (the port the `gateway` container already publishes
# on localhost only), not to the internal `gateway` hostname of this project's
# Docker network — because this file runs outside docker-compose.
#
# Usage:
#   1. Do NOT start this repo's `nginx`/`certbot` service — only the gateway:
#        docker compose -f infra/docker/docker-compose.yml up -d gateway
#   2. Copy this file (with the domain already replaced) to the host nginx:
#        sudo cp infra/docker/nginx/host-nginx-site.conf.example \
#          /etc/nginx/sites-available/seu-dominio.exemplo.com.conf
#        sudo ln -s /etc/nginx/sites-available/seu-dominio.exemplo.com.conf \
#          /etc/nginx/sites-enabled/
#        sudo nginx -t && sudo systemctl reload nginx
#   3. Issue the certificate with the certbot already installed on the host (reuses the
#      one that already issues certificates for the VPS's other domains):
#        sudo certbot --nginx -d seu-dominio.exemplo.com
#      (the --nginx plugin edits this file on its own, adding the
#      ssl_certificate/ssl_certificate_key paths and the 80→443 redirect)
#
# See the README ("Deploy em produção — Cenário B") for the full
# steps, including the Cloudflare caveat (DNS-only during the
# first certificate issuance).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

log_format agent_sem_token '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

server {
    listen 80;
    server_name seu-dominio.exemplo.com;

    # Library uploads (/api/arquivos).
    client_max_body_size 200m;

    # Login rate-limited by real IP (agent_login zone in seguranca-http.conf).
    location = /api/auth/login {
        limit_req zone=agent_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:48080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Collabora admin console: not used and kept off the internet.
    location ^~ /browser/dist/admin { return 404; }
    location ^~ /cool/adminws { return 404; }

    location / {
        proxy_pass http://127.0.0.1:48080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # The PC's esteira through the tunnel (`tunel` service): only with the app session token, in the header or
    # in ?token= (image and video). The log omits the query so the token is not recorded.
    location /esteira/ {
        auth_request /_auth_esteira;
        access_log /var/log/nginx/access.log agent_sem_token;
        proxy_pass http://127.0.0.1:18765/;
        proxy_http_version 1.1;
        proxy_set_header Host localhost;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Collabora Online (`collabora` service, published on 127.0.0.1:9980). Token in the URL (WOPI):
    # log without the query.
    location ^~ /browser {
        access_log /var/log/nginx/access.log agent_sem_token;
        proxy_pass http://127.0.0.1:9980;
        proxy_set_header Host $host;
    }

    location ^~ /hosting/discovery {
        proxy_pass http://127.0.0.1:9980;
        proxy_set_header Host $host;
    }

    location ^~ /hosting/capabilities {
        proxy_pass http://127.0.0.1:9980;
        proxy_set_header Host $host;
    }

    location ^~ /cool/ {
        access_log /var/log/nginx/access.log agent_sem_token;
        proxy_pass http://127.0.0.1:9980;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 36000s;
    }

    location = /_auth_esteira {
        internal;
        proxy_pass http://127.0.0.1:48080/api/auth/verificar;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
    }
}

# After "certbot --nginx", a "listen 443 ssl" server block equivalent
# to this one is added automatically below by certbot — no need
# to write it by hand.
