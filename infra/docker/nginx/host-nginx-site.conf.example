# Variante para VPS COMPARTILHADA — quando a VPS já roda outros
# sites/serviços num nginx instalado direto no host (fora de Docker), em vez
# do nginx dockerizado deste repo (infra/docker/nginx/nginx.conf).
#
# Diferença principal para o nginx.conf.example "padrão": aqui o proxy_pass
# aponta para 127.0.0.1:48080 (a porta que o container `gateway` já publica
# só em localhost), e não para o hostname interno `gateway` da rede Docker
# deste projeto — porque este arquivo roda fora do docker-compose.
#
# Uso:
#   1. NÃO suba o serviço `nginx`/`certbot` deste repo — só o gateway:
#        docker compose -f infra/docker/docker-compose.yml up -d gateway
#   2. Copie este arquivo (com o domínio já trocado) para o nginx do host:
#        sudo cp infra/docker/nginx/host-nginx-site.conf.example \
#          /etc/nginx/sites-available/seu-dominio.exemplo.com.conf
#        sudo ln -s /etc/nginx/sites-available/seu-dominio.exemplo.com.conf \
#          /etc/nginx/sites-enabled/
#        sudo nginx -t && sudo systemctl reload nginx
#   3. Emita o certificado com o certbot já instalado no host (reaproveita o
#      que já emite certificado para os outros domínios da VPS):
#        sudo certbot --nginx -d seu-dominio.exemplo.com
#      (o plugin --nginx edita este arquivo sozinho, adicionando os
#      caminhos de ssl_certificate/ssl_certificate_key e o redirect 80→443)
#
# Veja o README ("Deploy em produção — Cenário B") para o passo a passo
# completo, incluindo a ressalva sobre Cloudflare (DNS-only durante a
# primeira emissão do certificado).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

log_format agent_sem_token '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

server {
    listen 80;
    server_name seu-dominio.exemplo.com;

    # Uploads da biblioteca (/api/arquivos).
    client_max_body_size 200m;

    # Login com limite por IP real (zona agent_login em seguranca-http.conf).
    location = /api/auth/login {
        limit_req zone=agent_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:48080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Console de administração do Collabora: não é usado e não fica na internet.
    location ^~ /browser/dist/admin { return 404; }
    location ^~ /cool/adminws { return 404; }

    location / {
        proxy_pass http://127.0.0.1:48080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Esteira do PC pelo túnel (serviço `tunel`): só com o token de sessão do app, no cabeçalho ou
    # em ?token= (imagem e vídeo). O log sai sem a query para o token não ficar gravado.
    location /esteira/ {
        auth_request /_auth_esteira;
        access_log /var/log/nginx/access.log agent_sem_token;
        proxy_pass http://127.0.0.1:18765/;
        proxy_http_version 1.1;
        proxy_set_header Host localhost;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Collabora Online (serviço `collabora`, publicado em 127.0.0.1:9980). Token na URL (WOPI):
    # log sem a query.
    location ^~ /browser {
        access_log /var/log/nginx/access.log agent_sem_token;
        proxy_pass http://127.0.0.1:9980;
        proxy_set_header Host $host;
    }

    location ^~ /hosting/discovery {
        proxy_pass http://127.0.0.1:9980;
        proxy_set_header Host $host;
    }

    location ^~ /hosting/capabilities {
        proxy_pass http://127.0.0.1:9980;
        proxy_set_header Host $host;
    }

    location ^~ /cool/ {
        access_log /var/log/nginx/access.log agent_sem_token;
        proxy_pass http://127.0.0.1:9980;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 36000s;
    }

    location = /_auth_esteira {
        internal;
        proxy_pass http://127.0.0.1:48080/api/auth/verificar;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
    }
}

# Depois do "certbot --nginx", um server block "listen 443 ssl" equivalente
# a este é adicionado automaticamente aqui embaixo pelo certbot — não
# precisa escrever à mão.
