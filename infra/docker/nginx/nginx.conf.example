# infra/scripts/instalar_vps generates nginx.conf from this file on its own. By hand: copy this file to nginx.conf (same directory) and replace
# "seu-dominio.exemplo.com" with your VPS's real domain. This file is
# generic on purpose — no domain from any specific install —
# so anyone can use the LLM Gateway in their own
# project. See plataforma/backend/.env.example for the same convention.
#
# NEVER commit nginx.conf with your real domain. Only this
# nginx.conf.example belongs in the public repository (it is already covered
# by the root .gitignore).
#
# Certificate bootstrap (first time, before a certificate exists):
#   1. Comment out the HTTPS (443) server block below, leaving only the
#      HTTP (80) server block with the acme-challenge location.
#   2. docker compose -f infra/docker/docker-compose.yml up -d nginx
#   3. docker compose -f infra/docker/docker-compose.yml run --rm --entrypoint certbot certbot \
#        certonly --webroot -w /var/www/certbot \
#        -d seu-dominio.exemplo.com --email you@example.com --agree-tos
#   4. Uncomment the HTTPS server block and restart:
#      docker compose -f infra/docker/docker-compose.yml restart nginx
#   5. Automatic renewal already runs through the docker-compose.yml `certbot`
#      service (a `certbot renew` loop every 12h).
#
# Domain behind Cloudflare? Keep the DNS record on "DNS only" during
# step 3 and only switch to "Proxied" after the certificate is issued — see the
# README ("Deploy em produção — Cloudflare") for the reason and the steps.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

log_format agent_sem_token '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

server {
    listen 80;
    server_name seu-dominio.exemplo.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name seu-dominio.exemplo.com;

    ssl_certificate     /etc/letsencrypt/live/seu-dominio.exemplo.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/seu-dominio.exemplo.com/privkey.pem;

    # Library uploads (/api/arquivos): large PDFs and presentations.
    client_max_body_size 200m;

    # Login rate-limited by real IP (agent_login zone in seguranca-http.conf).
    location = /api/auth/login {
        limit_req zone=agent_login burst=5 nodelay;
        proxy_pass http://gateway:48080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Collabora admin console: not used and kept off the internet.
    location ^~ /browser/dist/admin { return 404; }
    location ^~ /cool/adminws { return 404; }

    location / {
        proxy_pass http://gateway:48080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # SSE (chat completions streaming) and WebSocket (Worker) need
        # buffering off and a timeout longer than the nginx default.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # The PC's esteira through the tunnel (`tunel` service): only with the app session token, in the header or
    # in ?token= (image and video). The log omits the query so the token is not recorded.
    location /esteira/ {
        auth_request /_auth_esteira;
        access_log /var/log/nginx/access.log agent_sem_token;
        proxy_pass http://tunel:8765/;
        proxy_http_version 1.1;
        proxy_set_header Host localhost;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Collabora Online (`collabora` service): editor and discovery on the same domain. The token goes in the
    # URL (WOPI): log without the query.
    location ^~ /browser {
        access_log /var/log/nginx/access.log agent_sem_token;
        proxy_pass http://collabora:9980;
        proxy_set_header Host $host;
    }

    location ^~ /hosting/discovery {
        proxy_pass http://collabora:9980;
        proxy_set_header Host $host;
    }

    location ^~ /hosting/capabilities {
        proxy_pass http://collabora:9980;
        proxy_set_header Host $host;
    }

    # WebSocket of the open document (and downloads/printing).
    location ^~ /cool/ {
        access_log /var/log/nginx/access.log agent_sem_token;
        proxy_pass http://collabora:9980;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 36000s;
    }

    location = /_auth_esteira {
        internal;
        proxy_pass http://gateway:48080/api/auth/verificar;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
    }
}
