# infra/scripts/instalar_vps gera o nginx.conf sozinho a partir deste. À mão: copie este arquivo para nginx.conf (no mesmo diretório) e troque
# "seu-dominio.exemplo.com" pelo domínio real da sua VPS. Este arquivo é
# genérico de propósito — sem domínio de nenhuma instalação específica —
# para que qualquer pessoa possa usar o LLM Gateway em seu próprio
# projeto. Veja plataforma/backend/.env.example para a mesma convenção.
#
# NUNCA commite o arquivo nginx.conf com seu domínio real. Apenas este
# nginx.conf.example deve ir para o repositório público (já está protegido
# no .gitignore da raiz).
#
# Bootstrap do certificado (primeira vez, antes de existir certificado):
#   1. Comente o server block HTTPS (443) abaixo, deixando só o server
#      block HTTP (80) com o location do acme-challenge.
#   2. docker compose -f infra/docker/docker-compose.yml up -d nginx
#   3. docker compose -f infra/docker/docker-compose.yml run --rm --entrypoint certbot certbot \
#        certonly --webroot -w /var/www/certbot \
#        -d seu-dominio.exemplo.com --email voce@exemplo.com --agree-tos
#   4. Descomente o server block HTTPS e reinicie:
#      docker compose -f infra/docker/docker-compose.yml restart nginx
#   5. A renovação automática já roda pelo serviço `certbot` do
#      docker-compose.yml (loop de `certbot renew` a cada 12h).
#
# Domínio atrás do Cloudflare? Deixe o registro DNS em "DNS only" durante o
# passo 3 e só troque para "Proxied" depois do certificado emitido — veja o
# README ("Deploy em produção — Cloudflare") para o motivo e o passo a passo.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

log_format agent_sem_token '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

server {
    listen 80;
    server_name seu-dominio.exemplo.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name seu-dominio.exemplo.com;

    ssl_certificate     /etc/letsencrypt/live/seu-dominio.exemplo.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/seu-dominio.exemplo.com/privkey.pem;

    # Uploads da biblioteca (/api/arquivos): PDFs e apresentações grandes.
    client_max_body_size 200m;

    # Login com limite por IP real (zona agent_login em seguranca-http.conf).
    location = /api/auth/login {
        limit_req zone=agent_login burst=5 nodelay;
        proxy_pass http://gateway:48080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Console de administração do Collabora: não é usado e não fica na internet.
    location ^~ /browser/dist/admin { return 404; }
    location ^~ /cool/adminws { return 404; }

    location / {
        proxy_pass http://gateway:48080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # SSE (streaming de chat completions) e WebSocket (Worker) precisam
        # de buffering desligado e timeout maior que o padrão do nginx.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Esteira do PC pelo túnel (serviço `tunel`): só com o token de sessão do app, no cabeçalho ou
    # em ?token= (imagem e vídeo). O log sai sem a query para o token não ficar gravado.
    location /esteira/ {
        auth_request /_auth_esteira;
        access_log /var/log/nginx/access.log agent_sem_token;
        proxy_pass http://tunel:8765/;
        proxy_http_version 1.1;
        proxy_set_header Host localhost;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Collabora Online (serviço `collabora`): editor e discovery no mesmo domínio. O token vai na
    # URL (WOPI): log sem a query.
    location ^~ /browser {
        access_log /var/log/nginx/access.log agent_sem_token;
        proxy_pass http://collabora:9980;
        proxy_set_header Host $host;
    }

    location ^~ /hosting/discovery {
        proxy_pass http://collabora:9980;
        proxy_set_header Host $host;
    }

    location ^~ /hosting/capabilities {
        proxy_pass http://collabora:9980;
        proxy_set_header Host $host;
    }

    # WebSocket do documento aberto (e downloads/impressão).
    location ^~ /cool/ {
        access_log /var/log/nginx/access.log agent_sem_token;
        proxy_pass http://collabora:9980;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 36000s;
    }

    location = /_auth_esteira {
        internal;
        proxy_pass http://gateway:48080/api/auth/verificar;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
    }
}
