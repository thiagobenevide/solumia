# Copie este arquivo para .env e ajuste os valores para o SEU ambiente.
#
# Todas as variáveis usam o prefixo WORKER_.
#
# NUNCA commite o arquivo .env (com valores reais). Veja SECURITY.md.

# Nome exibido nos logs (seus e do Gateway) para identificar esta máquina.
WORKER_NAME=worker-local

# Endpoint WebSocket do Gateway. Use wss:// em produção (atrás do nginx/TLS);
# ws://localhost:48080/ws/worker só serve para testar contra um Gateway
# rodando localmente na sua própria máquina.
WORKER_GATEWAY_URL=wss://solumialocal.thiagobenevide.com/ws/worker

# Precisa ser um dos valores presentes em GATEWAY_WORKER_API_KEYS no Gateway.
WORKER_API_KEY=worker_replace_with_your_own_generated_key

# llama.cpp em modo roteador: um llama-server (compartilhado com a esteira) serve todos os
# modelos da pasta: .gguf solto, ou subpasta com o modelo + mmproj-*.gguf (visão). Eles
# aparecem na tela "Modelo de IA" do app, que troca o modelo na hora.
WORKER_LLAMA_SERVER_BIN=~/development/llama.cpp/build/bin/llama-server
WORKER_MODELOS_DIR=~/agent-data/modelos
WORKER_LLAMA_PORTA=8081
# Um modelo na VRAM por vez, camadas na GPU, contexto, template de chat, descarga após 10 min.
WORKER_LLAMA_ARGS=--models-max 1 --fit on -c 16384 --jinja --sleep-idle-seconds 600

# debug | info | warning | error | critical
WORKER_LOG_LEVEL=info

# json (produção) | console (dev, legível por humano)
WORKER_LOG_FORMAT=console
