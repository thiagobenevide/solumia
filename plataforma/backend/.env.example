# Copie este arquivo para .env e ajuste os valores para o SEU ambiente
# (seu domínio, seu VPS, suas próprias chaves). Este arquivo é genérico de
# propósito — não contém dados de nenhuma instalação específica — para que
# qualquer pessoa possa usar o LLM Gateway em seu próprio projeto.
#
# Todas as variáveis usam o prefixo GATEWAY_.
#
# NUNCA commite o arquivo .env (com valores reais). Apenas este .env.example
# deve ir para o repositório público. Veja SECURITY.md para mais detalhes.

# Nome exibido em logs e no endpoint /health
GATEWAY_APP_NAME="LLM Gateway"

# development | staging | production
GATEWAY_ENVIRONMENT=development

# Ativa reload/detalhes extras de erro. Nunca usar "true" em produção.
GATEWAY_DEBUG=true

# Endereço/porta em que o uvicorn escuta
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=48080

# debug | info | warning | error | critical
GATEWAY_LOG_LEVEL=info

# json (produção, logs estruturados) | console (dev, legível por humano)
GATEWAY_LOG_FORMAT=console

# Origens permitidas para CORS, separadas por vírgula. "*" libera todas.
GATEWAY_CORS_ORIGINS=*

# --- Segredos ---
# Os valores abaixo são apenas EXEMPLOS DE FORMATO, não são chaves reais.
# Gere as suas com:
#
#   python -c "import secrets; print('sk_live_' + secrets.token_urlsafe(32))"
#   python -c "import secrets; print('worker_' + secrets.token_urlsafe(32))"
#   python -c "import secrets; print(secrets.token_hex(32))"

# Chaves de cliente aceitas pelo Gateway (usadas por Claude Code, Cursor,
# Continue.dev, Open WebUI, SDKs OpenAI, etc). Múltiplas separadas por vírgula.
# Validadas em todo endpoint /v1/* via "Authorization: Bearer <key>" — vazio
# significa que NENHUM cliente consegue usar a API (fail-secure).
GATEWAY_CLIENT_API_KEYS=sk_live_replace_with_your_own_generated_key

# Chave(s) que o Worker (sua máquina pessoal) apresenta ao conectar no
# Gateway. Múltiplas separadas por vírgula.
GATEWAY_WORKER_API_KEYS=worker_replace_with_your_own_generated_key

# --- Login do app: senha + Google Authenticator (2FA) ---
# Gere todas as linhas abaixo de uma vez com:
#   .venv/bin/python -m backend.auth.seguranca
# e cadastre a chave TOTP no Google Authenticator. Qualquer uma vazia = login desligado.
GATEWAY_ADMIN_USUARIO=admin
GATEWAY_ADMIN_SENHA_HASH=
GATEWAY_ADMIN_TOTP_SEGREDO=
# Assina o token de sessão (mín. 32 caracteres). Trocar invalida todas as sessões.
GATEWAY_JWT_SECRET_KEY=
GATEWAY_JWT_EXPIRE_MINUTES=720
# Falhas de login por IP antes do bloqueio, e por quanto tempo bloqueia.
GATEWAY_LOGIN_MAX_TENTATIVAS=5
GATEWAY_LOGIN_BLOQUEIO_MINUTOS=15

# --- Worker (Etapa 3) ---
# Intervalo sugerido ao Worker entre heartbeats (segundos).
GATEWAY_WORKER_HEARTBEAT_INTERVAL_SECONDS=20

# Tempo sem heartbeat após o qual um worker é considerado morto (segundos).
GATEWAY_WORKER_STALE_AFTER_SECONDS=60

# Timeout aguardando a resposta do worker para um chat completion (segundos).
GATEWAY_CHAT_REQUEST_TIMEOUT_SECONDS=120

# Pasta dos Markdown das notas (/api/notas). Pode ser o vault do Obsidian ou uma subpasta.
GATEWAY_NOTAS_DIR=~/agent-data/notas
# Vault de onde POST /api/youtube/importar traz os canais (Notas/Empreendimento/YouTube) para as notas.
GATEWAY_YOUTUBE_VAULT=~/Documents/github/obsidian
GATEWAY_ROTINAS_DIR=~/agent-data/rotinas
GATEWAY_DESIGN_DIR=~/agent-data/design

# Painel (Cobrador): metas, agenda do dia e chat. Sem chave da Anthropic o chat usa só o LLM local.
GATEWAY_PAINEL_DIR=~/agent-data/painel
GATEWAY_PAINEL_FUSO=America/Sao_Paulo
# Push das cobranças (app ntfy no celular/PC): tópico difícil de adivinhar ou protegido por token.
GATEWAY_PAINEL_NTFY_URL=
GATEWAY_PAINEL_NTFY_TOKEN=
GATEWAY_PAINEL_COBRANCA_MINUTOS=15

# Finanças: contas, extrato, metas, empresas e carteira
GATEWAY_FINANCAS_DIR=~/agent-data/financas

# Biblioteca de arquivos (/api/arquivos): PDF, DOCX e PPTX com as anotações do app.
# DOCX/PPTX viram PDF pelo LibreOffice; a miniatura sai do pdftoppm (poppler-utils).
GATEWAY_ARQUIVOS_DIR=~/agent-data/arquivos
GATEWAY_SOFFICE_BIN=soffice
GATEWAY_PDFTOPPM_BIN=pdftoppm
