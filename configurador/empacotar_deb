#!/usr/bin/env bash
# Builds the configurator into a .deb: Flutter interface (release) + Python core in its own venv,
# installed to /opt/solumia-configurador with a menu shortcut and the `solumia-configurador` command.
# Does not touch the older installation (~/.local/opt/agent, agent-* units).
#
#   configurador/empacotar_deb              # generates configurador/build/solumia-configurador_<v>_amd64.deb
#   configurador/empacotar_deb --instalar   # also installs it (pkexec asks for the password in a window)
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
repo="$(cd "$here/.." && pwd)"
flutter="$(command -v flutter || echo "$HOME/development/flutter/bin/flutter")"
uv="$(command -v uv || echo "$HOME/.local/bin/uv")"
name="solumia-configurador"
opt="/opt/$name"
base="$(grep -m1 '^version' "$here/core/pyproject.toml" | cut -d'"' -f2)"
version="$base+$(date +%Y%m%d%H%M)"
out="$here/build"
stage="$out/deb"
deb="$out/${name}_${version}_amd64.deb"

echo "→ interface (Flutter, release)"
cd "$here/app"
grep -qs 'CMAKE_INSTALL_PREFIX:PATH=/usr/local' build/linux/x64/release/CMakeCache.txt && rm -rf build/linux
"$flutter" build linux --release >/dev/null

rm -rf "$stage" && mkdir -p "$stage$opt/nucleo" "$stage/usr/bin" "$stage/usr/share/applications" "$stage/DEBIAN" \
    "$stage/usr/share/icons/hicolor/256x256/apps"
cp -r build/linux/x64/release/bundle/. "$stage$opt/"

echo "→ núcleo (Python, venv próprio com as versões do uv.lock)"
venv="$stage$opt/nucleo/venv"
"$uv" venv --quiet --relocatable --python /usr/bin/python3 "$venv"
"$uv" export --quiet --frozen --no-dev --no-hashes --no-emit-project --project "$here/core" -o "$out/requisitos.txt"
"$uv" pip install --quiet --python "$venv/bin/python" -r "$out/requisitos.txt"
"$uv" pip install --quiet --python "$venv/bin/python" --no-deps "$here/core"
"$venv/bin/python" -m compileall -q "$venv/lib" >/dev/null || true

# The core packs the VPS code and runs the worker from this repository.
cat > "$stage$opt/nucleo/$name" <<EOF
#!/bin/sh
export SOLUMIA_REPO="\${SOLUMIA_REPO:-$repo}"
exec "$opt/nucleo/venv/bin/$name" "\$@"
EOF
chmod 0755 "$stage$opt/nucleo/$name"
ln -s "$opt/solumia_configurador" "$stage/usr/bin/$name"

# Solumia logo as the app icon. The .desktop file is named after the GTK application id
# (configurador/app/linux/CMakeLists.txt) so GNOME on Wayland matches the window to it; on X11
# StartupWMClass (the binary name) does the same.
cp "$here/app/assets/logo.png" "$stage/usr/share/icons/hicolor/256x256/apps/$name.png"
cat > "$stage/usr/share/applications/dev.solumia.solumia_configurador.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Solumia
GenericName=Configurador do Solumia
Comment=Instalar, configurar e operar o Solumia
Exec=$opt/solumia_configurador
Icon=$name
Terminal=false
Categories=Utility;Settings;
StartupWMClass=solumia_configurador
EOF

size="$(du -sk "$stage" | cut -f1)"
cat > "$stage/DEBIAN/control" <<EOF
Package: $name
Version: $version
Section: utils
Priority: optional
Architecture: amd64
Depends: python3 (>= 3.12), libgtk-3-0t64 | libgtk-3-0
Installed-Size: $size
Maintainer: Solumia <noreply@solumia.dev>
Description: Configurador do Solumia
 Instala, configura e opera o Solumia (VPS, worker, pastas, Craft Apps e apps)
 sem terminal, com assistente do Claude Code e convivendo com a instalação "agent".
EOF

rm -f "$out/${name}"_*_amd64.deb
dpkg-deb --root-owner-group -Zxz --build "$stage" "$deb" >/dev/null
rm -rf "$stage" "$out/requisitos.txt"
echo "✔ pacote: $deb"

if [ "${1:-}" = "--instalar" ]; then
    echo "→ instalando (pkexec pede a senha numa janela)"
    pkexec /usr/bin/dpkg -i "$deb"
    echo "✔ instalado: abra \"Solumia: configurador\" no menu de aplicativos"
fi
